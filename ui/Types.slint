// Data shapes exchanged between Rust and the UI, plus the single shared
// UI-state global. Rust owns construction (VecModel), UI owns presentation.

export struct SidebarNode {
    id: int,
    label: string,
    kind: string,   // "header" | "favorite" | "recent" | "page" | "new-page"
    depth: int,
    expanded: bool,
    has-children: bool,
    selected: bool,
    y: int,         // cumulative px offset in the tree area (menu anchoring)
}

export struct TextRun {
    text: string,
    bold: bool,
    italic: bool,
    strike: bool,
    code: bool,
    link: bool,
    url: string,
}

/// One cell of a table (SPEC §三十七 批次 B). The grid rides on its table's
/// row as a flat row-major list — Slint has no array of arrays in a struct —
/// with `columns` telling the delegate where each row ends.
export struct TableCell {
    id: int,
    text: string,
    runs: [TextRun], // inline marks; a cell carries them like any block
}

/// One block inside a columns layout (SPEC §三十七 批次 B). Its column is a
/// child block the projection leaves out of the row list, so the layout's
/// whole content rides on the layout's own row as one flat list, grouped by
/// box: `column` says which box, `depth` how far inside that box.
export struct ColumnItem {
    id: int,
    column: int, // 0-based box of the layout
    depth: int, // nesting inside its own column, for the indent
    kind: int, // same ints as BlockRow.kind: only the marker differs
    text: string,
    runs: [TextRun],
    checked: bool,
    number: int, // numbered-list position inside its own box
    folded: bool, // a toggle's subtree is left out of this list, as in the rows
    can-fold: bool,
    color: int,
    bg: int, // callout tint, same palette slots
    attachment: int, // picture an image item points at; 0 = none
}

/// One box of a columns layout, as the delegate sees it: the `Column` block
/// it is, and where its content sits in the flat `column-items` list. Slint
/// has no recursive components, so this is how a layout finds its own shape.
export struct ColumnBox {
    id: int,
    column: int, // 0-based position in the layout
    first: int,  // index in `column-items` of this box's first item
    size: int,   // how many items it holds; 0 = nothing to draw yet
}

export struct BlockRow {
    id: int,
    kind: int, // 0 para, 1 h1, 2 h2, 3 h3, 4 bullet, 5 numbered, 6 todo, 7 quote, 8 code, 9 divider, 10 callout, 11 page, 12 link, 13 toggle, 14 image, 15 file, 16 table, 18 columns (17 = table_cell, 19 = column: containers' children, never a row)
    text: string,
    checked: bool,
    number: int,
    tail: bool, // last block of the page: the delegate carries the bottom spacer
    runs: [TextRun], // inline marks (M6); empty = render `text` as one run
    depth: int, // list nesting level (0-1 in M4; drives the indent)
    color: int, // text palette slot (0 = theme default, 1.. = gray..red)
    bg: int,    // row background palette slot (0 = transparent)
    page-ref: int, // the page a Page-kind block (11) opens; -1 = none/dangling
    folded: bool, // toggle (13) showing its chevron collapsed; its subtree has no rows
    can-fold: bool, // this block has children (the chevron itself is toggle-only)
    attachment: int, // attachments row an image (14) or file (15) points at; 0 = none
    img-percent: int, // image display width, percent of the editor column
    columns: int, // table (16) or columns (18) box count; 0 = neither
    // a table's cells, row-major: cell (r,c) is `table-cells[r * columns + c]`
    table-cells: [TableCell],
    // a columns layout's content, grouped by box in box order
    column-items: [ColumnItem],
    // and its boxes, left to right: the layout reads its own shape from these
    column-boxes: [ColumnBox],
}

export struct CommandRow {
    id: int,
    name: string,
    hint: string,
    section: string,
    icon: string,
}

export struct SearchRow {
    page-id: int,
    title: string,
    snippet: string, // content excerpt or breadcrumb for title/recents hits
    hit-block-id: int, // -1 for title/recents hits; else the matched block
}

export struct SlashRow {
    id: int,        // maps to a BlockKind in Rust; < 0 = placeholder row
    label: string,
    hint: string,
    disabled: bool, // placeholder for a later-milestone kind: muted, inert
}

export struct MenuRow {
    id: int,
    label: string,
    icon: string,
    danger: bool,
    swatch: int,     // palette slot for color rows; -1 = plain icon row
    swatch-bg: bool, // true: swatch resolves through the background palette
    check: bool,     // renders the "current pick" check at the row's right
}

// The one place transient UI state lives. Components read/write it directly;
// Rust reaches it through the generated global accessor.
export global UIState {
    in-out property <bool> dark: false;
    in-out property <bool> sidebar-open: true;

    in-out property <[SidebarNode]> sidebar-rows;
    in-out property <int> sidebar-selected-id: 0;
    in-out property <int> renaming-id: -1;      // page being renamed inline
    in-out property <length> tree-viewport-y: 0px; // PageTree scroll mirror

    in-out property <[BlockRow]> blocks;
    in-out property <string> page-title: "Getting Started";
    in-out property <string> page-breadcrumb: "";
    in-out property <length> editor-scroll-y: 0px; // Editor viewport mirror

    // slash menu (M5): "/" in an editing block filters Rust-provided
    // block-kind descriptors; the dropdown renders inside the delegate.
    // The same popup doubles as the "+"-handle insert menu (Notion-style):
    // slash-insert distinguishes the two modes — filter the whole line
    // instead of the text after "/", and discard the text on apply.
    // slash-pick-page is the third mode: the rows are workspace pages and
    // applying one converts the line into a Link-to-page block.
    in-out property <bool> slash-open: false;
    in-out property <bool> slash-insert: false;
    in-out property <bool> slash-pick-page: false;
    in-out property <string> slash-filter: "";
    in-out property <int> slash-focus: 0;
    in-out property <[SlashRow]> slash-items;
    in-out property <length> slash-x: 300px;
    in-out property <length> slash-y: 200px;

    // block menu (M5): ⋮⋮ handle menu for one block; visibility follows
    // block-menu-open-id (>= 0 open) — no separate bool to keep in sync
    in-out property <int> block-menu-open-id: -1;
    in-out property <[MenuRow]> block-menu-rows;
    in-out property <length> block-menu-x: 300px;
    in-out property <length> block-menu-y: 100px;

    // link dialog (M6): Ctrl+L over a selection
    in-out property <bool> link-open: false;
    in-out property <string> link-url: "";
    in-out property <int> link-start: 0;
    in-out property <int> link-end: 0;

    // startup notice (e.g. database restored from backup); empty = hidden
    in-out property <string> db-notice: "";
    // LAN sharing (read-only server on :5877); persisted, restart applies
    in-out property <bool> lan-sharing: false;
    callback toggle-lan-sharing();
    // true when the workspace has no pages: the empty state grows a CTA
    in-out property <bool> workspace-empty: false;

    // big page title in-place editing (click the title)
    in-out property <bool> title-editing: false;
    in-out property <string> page-stats: "";

    // in-page find (Ctrl+F)
    in-out property <bool> find-open: false;
    in-out property <string> find-term: "";
    in-out property <string> find-label: "";
    // the hit the bar navigated to: the editing input selects this range
    // when it (re)creates, driven by find-sel-gen
    in-out property <int> find-target-block: -1;
    in-out property <int> pending-sel-start: -1;
    in-out property <int> pending-sel-end: -1;
    in-out property <int> find-sel-gen: 0;
    /// Internal clipboard for cross-block copy/paste (menu-driven).
    in-out property <bool> has-copied-block: false;

    // block editing (M4): exactly one block owns the live TextInput.
    // editing-text mirrors that input; pending-caret is a byte offset the
    // input consumes on init (then resets to -1).
    in-out property <int> editing-id: -1;
    in-out property <string> editing-text: "";
    in-out property <int> pending-caret: -1;

    // command palette
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-focus: 0;
    in-out property <[CommandRow]> commands;
    in-out property <int> command-selected-id: -1;

    // search panel
    in-out property <bool> search-open: false;
    in-out property <string> search-query: "";
    in-out property <int> search-focus: 0;
    in-out property <int> search-selected-id: -1;
    in-out property <[SearchRow]> search-rows;

    // context menu (shared by sidebar rows and the TopBar ⋯ button)
    in-out property <bool> menu-open: false;
    in-out property <int> menu-node-id: -1;
    in-out property <length> menu-x: 240px;
    in-out property <length> menu-y: 100px;
    in-out property <[MenuRow]> menu-rows;

    // dialogs
    in-out property <bool> dialog-open: false;
    in-out property <string> dialog-title: "";
    in-out property <string> dialog-message: "";
    in-out property <string> dialog-confirm-label: "Delete";
    in-out property <bool> settings-open: false;
    // picture preview (SPEC §三十七): the attachments id shown full-window,
    // 0 = closed. Clicking a picture opens it; clicking the scrim closes it.
    in-out property <int> preview-attachment: 0;

    // window geometry mirror (for centering/anchoring popups from Rust)
    in-out property <length> window-w: 1280px;
    in-out property <length> window-h: 800px;

    in property <string> app-version: "0.1.0";
    in property <string> renderer-name: "unknown";

    // routed to Rust controller
    callback toggle-sidebar();
    callback toggle-theme();
    callback set-dark(bool);
    callback move-block(int);
    // drag-reorder (grip handle): Rust packs/unpacks the payload, hovers
    // validate the landing, drops commit one MoveBlockTo command
    pure callback block-drag-payload(int) -> data-transfer;
    callback block-drag-hover(data-transfer, int, bool) -> bool;
    callback block-dropped(data-transfer, int, bool);
    // insert-above row index shown as the accent drop line; == blocks.length
    // means "below the last block", -1 hidden
    in-out property <int> drop-line-row: -1;
    callback toggle-mark(int, int, int); // kind(0 bold,1 italic,2 strike,3 code), start, end
    callback indent-list(int);
    callback outdent-list(int);
    callback duplicate-block(int);
    callback link-apply();
    callback link-remove();
    callback link-cancel();
    callback close-db-notice();
    callback find-start();
    callback find-step(int);
    callback find-close();
    callback title-commit(string);
    callback title-cancel();
    // A page with no blocks shows a panel instead of rows, and every insert
    // command is anchored to a block that does not exist yet. This is that
    // panel's front door: make the first paragraph and put the caret in it.
    callback empty-page-started();
    callback open-link(string);
    callback palette-query-changed();
    callback palette-open-requested();
    callback command-invoked();
    callback palette-move(int);
    callback todo-toggled(int);
    // toggle block (SPEC §三十七): show/hide this block's subtree
    callback toggle-fold(int);
    // image block (SPEC §三十七 批次 A): resolve an attachments id to its
    // downsampled raster. A callback and not a model field, so a picture only
    // decodes for a row the ListView actually realizes. Both are `pure`: the
    // id always maps to the same picture, and Rust's cache makes the repeat
    // calls a binding evaluation costs a map lookup.
    pure callback image-for(int) -> image;
    // height / width of that raster, 0 when there is nothing to show. The row
    // needs the ratio to size itself before it has the picture, and a value
    // of type `image` does not expose its size to .slint.
    pure callback image-aspect(int) -> float;
    // file block (SPEC §三十七 批次 A): a row that names bytes instead of
    // drawing them. The label comes from the attachments row, so it is a
    // lookup and not a model field; the two actions hand those bytes to the
    // system, which is the only thing in the app that reaches outside it.
    pure callback attachment-size(int) -> string;
    callback attachment-opened(int);
    callback attachment-saved(int);
    callback block-activate(int);
    // table grid (SPEC §三十七 批次 B): the cells are child blocks the
    // projection hides, so they ride on their table's row and reach Rust
    // through these. Tab walks the grid row-major; the delete ops act on the
    // focused cell's row/column (Rust reads it back from editing-id), which
    // is why they carry no index.
    callback table-cell-move(int, int); // cell id, delta (+1 / -1)
    callback cell-changed(); // a container item's live text moved: re-arm the commit
    callback table-row-added(int);
    callback table-row-removed(int);
    callback table-column-added(int);
    callback table-column-removed(int);
    // columns layout (SPEC §三十七 批次 B): the boxes and their content are
    // child blocks the projection hides too, so the focused item is again read
    // back from editing-id. Tab walks the items in reading order; "remove"
    // always takes the layout's last box, which is why it carries no index.
    callback column-item-move(int, int); // item id, delta (+1 / -1)
    callback column-added(int);
    callback column-removed(int);
    // a box with no blocks has nothing to click into, so it offers its own id
    // and Rust gives it its first line
    callback column-fill(int); // box (Column block) id
    // rich paste (SPEC §二十七): true = the clipboard landed as blocks (the
    // key is consumed); false = fall through to the native plain paste
    callback rich-paste(int) -> bool;
    // storage row in the settings dialog (M8): the database folder + backup
    in-out property <string> data-dir: "";
    in-out property <bool> storage-available: false;
    callback open-data-folder();
    callback backup-now();
    // page-tree drag (SPEC §八): drag a page row onto another page (or the
    // Workspace header) to move it; page-drop-target-id drives the hover
    // highlight on the row being landed into
    pure callback page-drag-payload(int) -> data-transfer;
    callback page-drag-hover(data-transfer, int) -> bool;
    callback page-dropped(data-transfer, int);
    in-out property <int> page-drop-target-id: -1;
    callback editing-changed(length, length, length);
    callback enter-at-caret(int);
    callback backspace-at-start();
    callback focus-move(int);
    callback cancel-editing();
    callback undo-requested();
    callback redo-requested();
    callback save-requested();
    // Go Back / Go Forward through the session's page history (SPEC §十六).
    // Alt+Left / Alt+Right take the same path the palette rows do.
    callback nav-back-requested();
    callback nav-forward-requested();
    callback slash-move(int);
    callback slash-apply-selected();
    callback slash-close();
    callback block-menu-opened(int, length, length); // id, handle viewport-y, content-x
    callback block-menu-action(int);
    // "+" handle: id, the clicked block's bottom edge in list coords, and
    // the text-column x — the popup anchors below the block it inserts
    callback block-plus(int, length, length);

    callback node-clicked(int);
    callback node-expand-toggled(int);
    callback node-context(int);
    callback page-menu-requested();
    callback page-create-requested();
    callback rename-committed(int, string);
    callback rename-cancelled();
    callback menu-action(int);
    callback search-open-requested();
    callback search-query-changed();
    callback search-move(int);
    callback search-invoked();
    // opens a content hit with its matched block selected
    callback search-open-hit(int, int);
    callback dialog-confirmed();
    callback dialog-cancelled();
    callback settings-open-requested();
    callback settings-close-requested();
}
