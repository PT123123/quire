// Palette tokens. Every color in the app must come from here.
// Light: near-white backgrounds, warm-neutral ink, whisper-thin borders.
// Dark: never pure black; layered surfaces carry the hierarchy.

import { Theme } from "Theme.slint";

export global Colors {
    // ---- backgrounds & surfaces ----
    out property <color> background: Theme.dark ? #1a1a1e : #ffffff;
    out property <color> sidebar: Theme.dark ? #16161a : #f6f6f4;
    out property <color> surface: Theme.dark ? #1f1f24 : #ffffff;
    out property <color> surface-hover: Theme.dark ? #26262c : #efefec;
    out property <color> surface-selected: Theme.dark ? #2d2d34 : #e8e8e4;
    out property <color> surface-overlay: Theme.dark ? #212127 : #ffffff;
    out property <color> code-background: Theme.dark ? #101014 : #f6f6f4;

    // ---- text ----
    out property <color> text-primary: Theme.dark ? #e7e7ea : #1f2328;
    out property <color> text-secondary: Theme.dark ? #b4b4bb : #5f6569;
    // The third tier is the one that carries the palette's hint rows, block
    // handles and footers, and in light it used to sit at 2.71:1 on white --
    // the dimmest text in a light UI, which is a legibility floor, not a style.
    // #75787d is 4.43 on white / 4.10 on the sidebar, still clearly lighter
    // than secondary (5.91), so the three tiers survive. Dark was never the
    // problem: 4.25 / 4.02 on its surfaces.
    out property <color> text-muted: Theme.dark ? #7d7d86 : #75787d;
    out property <color> text-on-accent: Theme.dark ? #ffffff : #ffffff;

    // ---- lines & fills ----
    out property <color> border: Theme.dark ? #2b2b31 : #ebebea;
    out property <color> border-strong: Theme.dark ? #3b3b43 : #d9d9d6;
    out property <color> divider: Theme.dark ? #34343b : #e2e2df;

    // ---- semantic ----
    out property <color> accent: Theme.dark ? #8f87f0 : #5b54d6;
    out property <color> accent-soft: Theme.dark ? #2a2945 : #eeeeff;
    out property <color> accent-text: Theme.dark ? #a8a2f5 : #4a44b0;
    out property <color> danger: Theme.dark ? #f0776c : #d9412e;
    out property <color> success: Theme.dark ? #4cc38a : #1d9e6f;
    out property <color> selection: Theme.dark ? #3d4a86 : #b5d3f7;

    // ---- in-page find (SPEC §二十, A4 D7) ----
    // A match is painted as a cell around the matched text, so the token has
    // two jobs: read against the page, and leave the block's own text colour
    // alive. Only the border does the first. A fill bright enough to reach 3:1
    // on its own (an amber at #ffd75e, 1.39 here — it takes 3.0+ to reach it,
    // which is a solid yellow) drags yellow text to 2.85 and orange to 3.03,
    // so the fill stays pale and says only "this cell": #ffe9a8 keeps primary
    // text at 13.14 (from 15.80) and its worst coloured pair, yellow, at 3.29
    // (from 3.95 — the floor ADR-0023 already accepted). Dark mirrors it: fill
    // #3d3413 keeps primary at 10.02 (from 14.06) and worst pair purple at
    // 3.83 (from 5.37). The borders are #bd6408 and #a87718 — 4.21 and 4.39 on
    // their page, 3.50 and 3.13 on the fill they sit in — so the marker itself
    // clears 3:1 both ways.
    out property <color> find-hit: Theme.dark ? #3d3413 : #ffe9a8;
    out property <color> find-hit-border: Theme.dark ? #a87718 : #bd6408;

    // ---- interactive states ----
    out property <color> hover-fill: Theme.dark ? #ffffff14 : #0000000a;
    out property <color> pressed-fill: Theme.dark ? #ffffff20 : #00000014;
    out property <color> focus-ring: Colors.accent;

    // ---- shadows (used sparingly: popups & palette only) ----
    out property <color> shadow: Theme.dark ? #000000a0 : #00000026;
    out property <color> scrim: #00000059;

    // ---- callout block ----
    out property <color> callout-background: Theme.dark ? #2a2945 : #eeeeff;

    // ---- block color palette (Notion-style; ADR-0023) ----
    // Slot 0 is the theme default; 1..9 are gray..red. Values approximate
    // Notion's light/dark swatches so exported text stays readable.

    // text colors: pure function, resolved per row
    //
    // Slot 3 and 4 are measured, not eyeballed: on their own tint the light
    // orange and yellow used to sit at 2.81:1 and 2.48:1, the worst pair in the
    // palette and the reason an orange block on an orange background is the
    // hardest row to read. (The A4 sweep named "green-on-olive and red-on-black"
    // as the weakest pairs by eye; they measure 3.86 and 4.72, so that finding
    // is retracted and these two are the real ones.) They now read 3.61 and 3.56
    // on their tint, 4.21 and 3.95 on a plain background — and stop there,
    // because a darker orange is no longer orange. Every other slot is at or
    // above 3.71 in light and 4.72 in dark, and dark is unchanged.
    public pure function block-text(slot: int) -> color {
        if (slot <= 0) { return Theme.dark ? #e7e7ea : #1f2328; }
        if (slot == 1) { return Theme.dark ? #9b9a97 : #787774; }
        if (slot == 2) { return Theme.dark ? #c3996b : #9f6b53; }
        if (slot == 3) { return Theme.dark ? #e28d50 : #bd6408; }
        if (slot == 4) { return Theme.dark ? #dcae3f : #a87718; }
        if (slot == 5) { return Theme.dark ? #6ba584 : #448361; }
        if (slot == 6) { return Theme.dark ? #5b9bc4 : #337ea9; }
        if (slot == 7) { return Theme.dark ? #ad7fb8 : #9065b0; }
        if (slot == 8) { return Theme.dark ? #d3709f : #c14c8a; }
        return Theme.dark ? #e06d66 : #d44c47;
    }

    // code highlight (SPEC §三十七 批次 C): the colour of one layer of a code
    // block, keyed by core::highlight::Kind. Notion's own code colours are a
    // second palette, and this app already has one — the block swatches are
    // tuned for the same two backgrounds, so a keyword here is a purple block
    // there. 0 is the block's own colour and never comes through here: that
    // layer is the row's `code-text`, which paints `block-text-color`.
    public pure function code-token(kind: int) -> color {
        if (kind == 1) { return Colors.block-text(7); }  // keyword: purple
        if (kind == 2) { return Colors.block-text(1); }  // comment: gray
        if (kind == 3) { return Colors.block-text(5); }  // string: green
        if (kind == 4) { return Colors.block-text(3); }  // number: orange
        return Colors.block-text(6);                     // name: blue
    }

    // row background tints
    public pure function block-bg(slot: int) -> color {
        if (slot <= 0) { return transparent; }
        if (slot == 1) { return Theme.dark ? #2f2f2f : #f1f1ef; }
        if (slot == 2) { return Theme.dark ? #2e2420 : #f4eeee; }
        if (slot == 3) { return Theme.dark ? #38291c : #faebdd; }
        if (slot == 4) { return Theme.dark ? #372c14 : #fbf3db; }
        if (slot == 5) { return Theme.dark ? #1e2c21 : #edf3ec; }
        if (slot == 6) { return Theme.dark ? #1d272e : #e7f3f8; }
        if (slot == 7) { return Theme.dark ? #2a2233 : #f6f3f9; }
        if (slot == 8) { return Theme.dark ? #322028 : #faf1f5; }
        return Theme.dark ? #37201f : #fdebec;
    }
}
