// Name dispatcher used by sidebar rows and palette rows.
export component Icon {
    in property <string> name;
    in property <length> size: 16px;
    in property <brush> color: Colors.text-secondary;
    in property <length> stroke-width: 1.8px; // accepted for API symmetry; primitives carry their own

    width: root.size;
    height: root.size;

    IcSearch { visible: root.name == "search"; size: root.size; color: root.color; }
    IcChevronRight { visible: root.name == "chevron-right"; size: root.size; color: root.color; }
    IcChevronDown { visible: root.name == "chevron-down"; size: root.size; color: root.color; }
    IcChevronUp { visible: root.name == "chevron-up"; size: root.size; color: root.color; }
    IcChevronLeft { visible: root.name == "chevron-left"; size: root.size; color: root.color; }
    IcPencil { visible: root.name == "pencil"; size: root.size; color: root.color; }
    IcCopy { visible: root.name == "copy"; size: root.size; color: root.color; }
    IcTrash { visible: root.name == "trash"; size: root.size; color: root.color; }
    IcPlus { visible: root.name == "plus"; size: root.size; color: root.color; }
    IcX { visible: root.name == "x"; size: root.size; color: root.color; }
    IcGrip { visible: root.name == "grip"; size: root.size; color: root.color; }
    IcDotsHorizontal { visible: root.name == "dots-horizontal"; size: root.size; color: root.color; }
    IcSettings { visible: root.name == "settings"; size: root.size; color: root.color; }
    IcSun { visible: root.name == "sun"; size: root.size; color: root.color; }
    IcMoon { visible: root.name == "moon"; size: root.size; color: root.color; }
    IcPanelLeft { visible: root.name == "panel-left"; size: root.size; color: root.color; }
    IcPage { visible: root.name == "page"; size: root.size; color: root.color; }
    IcStar { visible: root.name == "star"; size: root.size; color: root.color; }
    IcClock { visible: root.name == "clock"; size: root.size; color: root.color; }
    IcMinimize { visible: root.name == "minimize"; size: root.size; color: root.color; }
    IcMaximize { visible: root.name == "maximize"; size: root.size; color: root.color; }
    IcTodoCheck { visible: root.name == "todo-check"; size: root.size; color: root.color; }
    IcExport { visible: root.name == "export"; size: root.size; color: root.color; }
    IcImport { visible: root.name == "import"; size: root.size; color: root.color; }
}
