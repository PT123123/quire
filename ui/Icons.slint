// Icon set drawn with Slint `Path` / `Line` primitives so strokes follow
// the theme. Original geometry on a 24×24 grid, 1.8 stroke, rounded caps.
// `Icon` dispatches by name; hot paths that render many instances use the
// concrete Ic* components directly.

import { Colors } from "Colors.slint";

export struct IconCtx {
    color: brush,
}

component IcSearch {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 11; y: 4; }
        ArcTo { radius-x: 7; radius-y: 7; x: 11; y: 18; }
        ArcTo { radius-x: 7; radius-y: 7; x: 11; y: 4; }
        MoveTo { x: 16; y: 16; } LineTo { x: 20; y: 20; }
    }
}

