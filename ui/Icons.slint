        stroke: color; stroke-width: 1.8px;
        stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 4; y: 5; } LineTo { x: 20; y: 5; }
        LineTo { x: 20; y: 19; } LineTo { x: 4; y: 19; } Close {}
        MoveTo { x: 9.5; y: 5; } LineTo { x: 9.5; y: 19; }
    }
}

