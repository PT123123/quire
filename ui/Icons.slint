        MoveTo { x: 4.4; y: 12; } LineTo { x: 5.6; y: 12; }
        MoveTo { x: 11.4; y: 12; } LineTo { x: 12.6; y: 12; }
        MoveTo { x: 18.4; y: 12; } LineTo { x: 19.6; y: 12; }
    }
}

