        fill: transparent;
        MoveTo { x: 4.5; y: 7; } LineTo { x: 19.5; y: 7; }
        MoveTo { x: 9.5; y: 4.5; } LineTo { x: 14.5; y: 4.5; }
        MoveTo { x: 7; y: 7; } LineTo { x: 7.8; y: 19.5; } LineTo { x: 16.2; y: 19.5; } LineTo { x: 17; y: 7; }
        MoveTo { x: 10; y: 10.5; } LineTo { x: 10; y: 16; }
