        fill: transparent;
        MoveTo { x: 6.5; y: 3; } LineTo { x: 14; y: 3; }
        LineTo { x: 18; y: 7; } LineTo { x: 18; y: 21; }
        LineTo { x: 6.5; y: 21; } Close {}
        MoveTo { x: 14; y: 3; } LineTo { x: 14; y: 7; } LineTo { x: 18; y: 7; }
    }
}

