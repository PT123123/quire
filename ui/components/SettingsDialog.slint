// Settings popup (M2 scope: appearance + about). Real settings persistence
// arrives with SQLite in M3.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Button } from "./Button.slint";
import { UIState } from "../Types.slint";

// One palette swatch of the theme picker (ADR: the theme catalog). The card
// paints the theme's own page ramp and writes its name in the theme's own ink,
// so it is a live preview rather than a label next to a colour — the same
// reason AW's Android shell draws swatches instead of a list.
component ThemeCard inherits Rectangle {
    in property <string> label;
    in property <brush> preview;
    in property <color> ink;
    in property <bool> active;
    callback clicked();

    width: 110px;
    height: 62px;
    border-radius: Theme.radius-md;
    background: root.preview;
    border-width: active ? 2px : 1px;
    border-color: active ? Colors.accent : Colors.border;
    clip: true;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        font-weight: active ? Typography.weight-semibold : Typography.weight-regular;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A line of the dialog that is **text to be copied, not chrome to be read**
// (ADR-0135). The version, the renderer and above all the data folder are the
// three strings a user is asked for when reporting a problem or moving a
// library, and all three used to be a bare `Text`: a `Text` in Slint cannot be
// focused, cannot hold a selection, and Ctrl+C over it reaches whatever focused
// input was last — which in a dialog whose only input is the 0×0 Escape proxy
// is nothing at all. So the one string a person needs was the one string they
// could not take away.
//
// A `TextInput` with `read-only` is the fix and it is exactly the right size: it
// is focusable, it takes a selection, it answers Ctrl+A and Ctrl+C, and it
// refuses every other key — so a click cannot turn a read-only line into an
// editable one. Slint 1.18 routes Copy and SelectAll before the read-only check
// (`items/text.rs`), and refuses Paste / Cut / Undo / Redo / character input
// behind it, which is the split this component depends on.
//
// The trade is the one a field has over a label: it draws a caret, and it takes
// focus. The caret is kept, because it is the affordance — a line of text with
// no caret is a label, and a label is exactly what these three rows used to be
// and exactly what the user could not copy from. Nothing else is added on top:
// the input's own mouse handling places the caret where the click landed and
// drags a selection from there, so this component declares no `TouchArea` of
// its own (one would sit above the input and swallow both).
component CopyableText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Typography.size-ui;
    in property <color> ink: Colors.text-primary;
    // Wrapped rather than elided, and off for the short values (a version, a
    // renderer name). A data folder is a long path in a 400 px card: elided, the
    // half that matters is the tail nobody can see, and a selected-then-copied
    // elision is worse than no text at all — it looks right and is wrong.
    in property <bool> wrap: false;
    in property <bool> mono: false;

    height: wrap
        ? input.preferred-height + 2px
        : input.preferred-height;
    // No border and no fill. A field chrome here would say "edit me", and the
    // only affordance this row offers is select-and-copy.
    background: transparent;
    border-width: 0px;

    input := TextInput {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        read-only: true;
        font-family: root.mono ? Typography.mono-font : Typography.ui-font;
        font-size: root.font-size;
        color: root.ink;
        // The selection is the one piece of state this row has, so it is drawn in
        // the app's own selection colour rather than the renderer's default —
        // which is a system accent that would not match the 全部笔记 chip the
        // user selected two rows away.
        selection-foreground-color: Colors.text-primary;
        selection-background-color: Colors.selection;
        wrap: root.wrap ? word-wrap : no-wrap;
        vertical-alignment: center;
    }
}

component ShortcutRow inherits Rectangle {
    in property <string> keys;
    in property <string> label;
    height: 20px;

    HorizontalLayout {
        CopyableText {
            width: 108px;
            text: root.keys;
            font-size: Typography.size-caption;
            ink: Colors.text-secondary;
            mono: true;
        }
        CopyableText {
            text: root.label;
            font-size: Typography.size-ui;
            ink: Colors.text-secondary;
        }
    }
}

export component SettingsDialog inherits PopupWindow {
    width: 400px;
    // The card grows with its sections but never past the window it is drawn
    // in: once the sync section landed the list outgrew a short window (and a
    // phone at the touch scale), and a dialog whose bottom rows are off-screen
    // has no way back — so the content scrolls instead (see the Flickable).
    height: Math.min(
        content-col.preferred-height + Theme.spacing-lg * 2,
        Math.max(UIState.window-h - 80px, 320px)
    );
    // Dismissed like every other popup in the window: a click outside it closes
    // it (Escape is the focus-proxy below). It used to be `no-auto-close`, so the
    // engine swallowed the outside click *and* the dialog ignored it — the card
    // stayed up over a page the user had already clicked into, and only 完成 or
    // Escape got rid of it. The `is-open` mirror in `AppWindow` carries the
    // dismissal back to `UIState`.
    close-policy: PopupClosePolicy.close-on-click-outside;

    property <bool> opened: UIState.settings-open;
    changed opened => {
        if (UIState.settings-open) {
            // steal focus so Esc reaches the input below
            focus-proxy.focus();
        }
    }

    focus-proxy := TextInput {
        x: 0; y: 0;
        width: 0px; height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                UIState.settings-close-requested();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            x: 2px; y: 3px;
            width: parent.width - 4px;
            height: parent.height - 5px;
            border-radius: Theme.radius-lg + 2px;
            background: Colors.shadow;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: Theme.radius-lg;
            background: Colors.surface-overlay;
            border-width: 1px;
            border-color: Colors.border;
        }

        Flickable {
            width: parent.width;
            height: parent.height;
            content-height: content-col.preferred-height;

            content-col := VerticalLayout {
                x: 0; y: 0;
                width: parent.width;
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;

                Text {
                    text: "设置";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-h3;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-primary;
            }

            Text {
                text: "外观";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            // AW's twelve themes, preceded by the one id that is not a palette
            // (跟随系统) (ADR: the theme catalog). Each card previews its own
            // ramp, so the picker reads without a legend. `FlexboxLayout` wraps
            // by default, which is what this needs: the dialog is a fixed
            // 400 px and the number of themes is data, not a layout decision.
            FlexboxLayout {
                width: parent.width;
                spacing: Theme.spacing-sm;
                ThemeCard {
                    label: "跟随系统";
                    preview: Colors.page;
                    ink: Colors.text-primary;
                    active: UIState.theme == "system";
                    clicked => {
                        UIState.set-theme("system");
                    }
                }
                for t in Colors.themes : ThemeCard {
                    label: t.emoji + " " + t.name;
                    preview: @linear-gradient(180deg, t.bg, t.grad2);
                    ink: t.fg;
                    active: UIState.theme == t.id;
                    clicked => {
                        UIState.set-theme(t.id);
                    }
                }
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "笔记";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                // Copyable (ADR-0135), because a toggle's own label is the text a
                // user copies when asking which setting is on — and these two are
                // the only prose in the dialog that is not itself a value.
                CopyableText {
                    text: "启动时自动弹出新建笔记输入框";
                    font-size: Typography.size-ui;
                    ink: Colors.text-secondary;
                    wrap: true;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: UIState.org-auto-input ? Colors.accent : Colors.border-strong;
                    animate background { duration: Theme.duration-fast; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            UIState.org-auto-input = !UIState.org-auto-input;
                            UIState.org-auto-input-toggled(UIState.org-auto-input);
                        }
                    }
                    Rectangle {
                        x: UIState.org-auto-input ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Colors.surface-overlay;
                        animate x { duration: Theme.duration-fast; }
                    }
                }
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "快捷键";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            // 全局快捷键: off in a library that never wrote the rows, which is
            // the default — a keystroke that works in every other application
            // is the user's to ask for, not the app's to assume.
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                CopyableText {
                    text: "全局 Alt+N 新建笔记";
                    font-size: Typography.size-ui;
                    ink: Colors.text-secondary;
                    wrap: true;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: UIState.hotkey-alt-n ? Colors.accent : Colors.border-strong;
                    animate background { duration: Theme.duration-fast; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            UIState.hotkey-alt-n = !UIState.hotkey-alt-n;
                            UIState.hotkey-alt-n-toggled(UIState.hotkey-alt-n);
                        }
                    }
                    Rectangle {
                        x: UIState.hotkey-alt-n ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Colors.surface-overlay;
                        animate x { duration: Theme.duration-fast; }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                CopyableText {
                    text: "全局 Alt+M 显示主界面";
                    font-size: Typography.size-ui;
                    ink: Colors.text-secondary;
                    wrap: true;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: UIState.hotkey-alt-m ? Colors.accent : Colors.border-strong;
                    animate background { duration: Theme.duration-fast; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            UIState.hotkey-alt-m = !UIState.hotkey-alt-m;
                            UIState.hotkey-alt-m-toggled(UIState.hotkey-alt-m);
                        }
                    }
                    Rectangle {
                        x: UIState.hotkey-alt-m ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Colors.surface-overlay;
                        animate x { duration: Theme.duration-fast; }
                    }
                }
            }
            Text {
                text: "开启后在任何应用前台都生效；与笔记页的 ＋ 是同一个输入框，含标签建议。";
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                wrap: TextWrap.word-wrap;
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "共享";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                CopyableText {
                    text: "在局域网内只读共享（端口 5877，重启后生效）";
                    font-size: Typography.size-ui;
                    ink: Colors.text-secondary;
                    wrap: true;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: UIState.lan-sharing ? Colors.accent : Colors.border-strong;
                    animate background { duration: Theme.duration-fast; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            UIState.lan-sharing = !UIState.lan-sharing;
                            UIState.toggle-lan-sharing();
                        }
                    }
                    Rectangle {
                        x: UIState.lan-sharing ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Colors.surface-overlay;
                        animate x { duration: Theme.duration-fast; }
                    }
                }
            }

            // ── LAN sync moved out (ADR-0132) ──────────────────────────────────
            //
            // The whole 同步 section — 本机名称 / 本机地址 / the auto switch / the
            // interval chips / the device rows / the log — used to live here,
            // between 局域网共享 and 存储, and it was the wrong shape for what it
            // is. A 400 px card that has to scroll cannot hold a seven-column
            // device table, a statistics box, or fifty stored log lines; what it
            // did hold was two lines per device and a 立即同步 button, which is
            // what made the section read as "特别特别简陋".
            //
            // It is now a **destination**: `ui/components/SyncPage.slint`, with
            // its own row in the rail. The settings row that used to be a second
            // copy of everything on it is gone rather than left pointing at the
            // new page — a link that opens a page you could already click in the
            // sidebar is a row that costs a click to say what the rail says for
            // free.

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "存储";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    CopyableText {
                        text: "数据文件夹";
                        font-size: Typography.size-ui;
                        ink: Colors.text-secondary;
                    }
                    // Wrapped, and copyable (ADR-0135) — this is the single most
                    // copied string in the app, and it used to be the one string
                    // that could not be copied at all: a `Text`, which cannot hold
                    // a selection, drawn `no-wrap` with `overflow: elide`, so the
                    // path was both unselectable and truncated in a 400 px card.
                    // Wrapping makes the whole path visible; the read-only input
                    // makes it takeable.
                    CopyableText {
                        text: UIState.storage-available ? UIState.data-dir
                            : "内存中运行 — 未挂载数据库";
                        font-size: Typography.size-caption;
                        ink: UIState.storage-available ? Colors.text-primary : Colors.text-muted;
                        mono: true;
                        wrap: true;
                    }
                }
                // A `visible: false` item keeps its slot in a Slint layout, so
                // these three are conditional children instead: hidden, they
                // still stole width from the label above (it elided two words
                // earlier) and the caption below them still cost a band of
                // empty height — both in sweep17's settings.png.
                if UIState.storage-available : HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    Button {
                        text: "打开文件夹";
                        clicked => {
                            UIState.open-data-folder();
                        }
                    }
                    Button {
                        text: "备份";
                        clicked => {
                            UIState.backup-now();
                        }
                    }
                    Button {
                        text: "清理";
                        clicked => {
                            UIState.reclaim-attachments();
                        }
                    }
                }
            }
            // one line about the only button here that deletes anything: the
            // notice it reports through is a toast, so the rule has to be
            // readable before the click (SPEC §三十七, ADR-0037)
            if UIState.storage-available : CopyableText {
                text: "清理会删除没有被任何块、撤销步骤或复制块引用的图片和文件。";
                font-size: Typography.size-caption;
                ink: Colors.text-muted;
                wrap: true;
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "快捷键";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            VerticalLayout {
                // single column: the two-column grid's right column used to
                // escape the card entirely (A4 sweep D2)
                spacing: Theme.spacing-xs;
                ShortcutRow { keys: "Ctrl+K"; label: "命令面板"; }
                ShortcutRow { keys: "Ctrl+P"; label: "搜索页面"; }
                ShortcutRow { keys: "Ctrl+F"; label: "页内查找"; }
                ShortcutRow { keys: "Ctrl+N"; label: "新建页面"; }
                ShortcutRow { keys: "Ctrl+\\"; label: "切换侧边栏"; }
                ShortcutRow { keys: "Ctrl+B / I / E / M"; label: "粗体 / 斜体 / 代码 / 公式"; }
                ShortcutRow { keys: "Tab / Shift+Tab"; label: "缩进 / 取消缩进"; }
                ShortcutRow { keys: "Ctrl+D"; label: "复制块"; }
                ShortcutRow { keys: "Ctrl+S"; label: "立即保存"; }
                ShortcutRow { keys: "Ctrl+= / Ctrl+-"; label: "放大 / 缩小（Ctrl+0 复位）"; }
                ShortcutRow { keys: "Alt+Left / Right"; label: "后退 / 前进"; }
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "关于";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                Text {
                    text: "版本";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle { width: 0px; }
                // Copyable (ADR-0135): the version is what a bug report is headed
                // with, and the 关于 section is where a user is sent to find it.
                CopyableText {
                    text: "Quire " + UIState.app-version;
                }
            }
            HorizontalLayout {
                Text {
                    text: "渲染器";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle { width: 0px; }
                // Copyable for the same reason, and mono because it is an
                // identifier rather than a sentence.
                CopyableText {
                    text: UIState.renderer-name;
                    font-size: Typography.size-caption;
                    mono: true;
                }
            }

            Rectangle { height: Theme.spacing-xs; }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "完成";
                    clicked => {
                        UIState.settings-close-requested();
                    }
                }
            }
            }
        }
    }
}
