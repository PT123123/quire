// Settings popup (M2 scope: appearance + about). Real settings persistence
// arrives with SQLite in M3.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Button } from "./Button.slint";
import { UIState } from "../Types.slint";

// One palette swatch of the theme picker (ADR: the theme catalog). The card
// paints the theme's own page ramp and writes its name in the theme's own ink,
// so it is a live preview rather than a label next to a colour — the same
// reason AW's Android shell draws swatches instead of a list.
component ThemeCard inherits Rectangle {
    in property <string> label;
    in property <brush> preview;
    in property <color> ink;
    in property <bool> active;
    callback clicked();

    width: 110px;
    height: 62px;
    border-radius: Theme.radius-md;
    background: root.preview;
    border-width: active ? 2px : 1px;
    border-color: active ? Colors.accent : Colors.border;
    clip: true;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        font-weight: active ? Typography.weight-semibold : Typography.weight-regular;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// One interval choice of the 同步 section. The dialog has no combo box, and the
// theme row above already draws its choices this way: a bordered shape whose
// border and ink say which one is the current answer.
component IntervalChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback picked();

    width: lab.preferred-width + Theme.spacing-sm * 2;
    height: 24px;
    border-radius: Theme.radius-md;
    background: root.selected ? Colors.selection : transparent;
    border-width: 1px;
    border-color: root.selected ? Colors.accent : Colors.border;

    lab := Text {
        x: Theme.spacing-sm;
        y: 0;
        height: parent.height;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        font-weight: root.selected ? Typography.weight-semibold : Typography.weight-regular;
        color: root.selected ? Colors.accent : Colors.text-secondary;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.picked();
        }
    }
}

component ShortcutRow inherits Rectangle {
    in property <string> keys;
    in property <string> label;
    height: 20px;

    HorizontalLayout {
        Text {
            width: 108px;
            text: root.keys;
            font-family: Typography.mono-font;
            font-size: Typography.size-caption;
            color: Colors.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.label;
            font-family: Typography.ui-font;
            font-size: Typography.size-ui;
            color: Colors.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component SettingsDialog inherits PopupWindow {
    width: 400px;
    // The card grows with its sections but never past the window it is drawn
    // in: once the sync section landed the list outgrew a short window (and a
    // phone at the touch scale), and a dialog whose bottom rows are off-screen
    // has no way back — so the content scrolls instead (see the Flickable).
    height: Math.min(
        content-col.preferred-height + Theme.spacing-lg * 2,
        Math.max(UIState.window-h - 80px, 320px)
    );
    // Dismissed like every other popup in the window: a click outside it closes
    // it (Escape is the focus-proxy below). It used to be `no-auto-close`, so the
    // engine swallowed the outside click *and* the dialog ignored it — the card
    // stayed up over a page the user had already clicked into, and only 完成 or
    // Escape got rid of it. The `is-open` mirror in `AppWindow` carries the
    // dismissal back to `UIState`.
    close-policy: PopupClosePolicy.close-on-click-outside;

    property <bool> opened: UIState.settings-open;
    changed opened => {
        if (UIState.settings-open) {
            // steal focus so Esc reaches the input below
            focus-proxy.focus();
        }
    }

    focus-proxy := TextInput {
        x: 0; y: 0;
        width: 0px; height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                UIState.settings-close-requested();
                accept
            } else {
                reject
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            x: 2px; y: 3px;
            width: parent.width - 4px;
            height: parent.height - 5px;
            border-radius: Theme.radius-lg + 2px;
            background: Colors.shadow;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: Theme.radius-lg;
            background: Colors.surface-overlay;
            border-width: 1px;
            border-color: Colors.border;
        }

        Flickable {
            width: parent.width;
            height: parent.height;
            content-height: content-col.preferred-height;

            content-col := VerticalLayout {
                x: 0; y: 0;
                width: parent.width;
                padding: Theme.spacing-lg;
                spacing: Theme.spacing-md;

                Text {
                    text: "设置";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-h3;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-primary;
            }

            Text {
                text: "外观";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            // AW's twelve themes, preceded by the one id that is not a palette
            // (跟随系统) (ADR: the theme catalog). Each card previews its own
            // ramp, so the picker reads without a legend. `FlexboxLayout` wraps
            // by default, which is what this needs: the dialog is a fixed
            // 400 px and the number of themes is data, not a layout decision.
            FlexboxLayout {
                width: parent.width;
                spacing: Theme.spacing-sm;
                ThemeCard {
                    label: "跟随系统";
                    preview: Colors.page;
                    ink: Colors.text-primary;
                    active: UIState.theme == "system";
                    clicked => {
                        UIState.set-theme("system");
                    }
                }
                for t in Colors.themes : ThemeCard {
                    label: t.emoji + " " + t.name;
                    preview: @linear-gradient(180deg, t.bg, t.grad2);
                    ink: t.fg;
                    active: UIState.theme == t.id;
                    clicked => {
                        UIState.set-theme(t.id);
                    }
                }
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "笔记";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                Text {
                    text: "打开笔记页时自动弹出输入框";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: UIState.org-auto-input ? Colors.accent : Colors.border-strong;
                    animate background { duration: Theme.duration-fast; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            UIState.org-auto-input = !UIState.org-auto-input;
                            UIState.org-auto-input-toggled(UIState.org-auto-input);
                        }
                    }
                    Rectangle {
                        x: UIState.org-auto-input ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Colors.surface-overlay;
                        animate x { duration: Theme.duration-fast; }
                    }
                }
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "共享";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                Text {
                    text: "在局域网内只读共享（端口 5877，重启后生效）";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: UIState.lan-sharing ? Colors.accent : Colors.border-strong;
                    animate background { duration: Theme.duration-fast; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            UIState.lan-sharing = !UIState.lan-sharing;
                            UIState.toggle-lan-sharing();
                        }
                    }
                    Rectangle {
                        x: UIState.lan-sharing ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Colors.surface-overlay;
                        animate x { duration: Theme.duration-fast; }
                    }
                }
            }

            Rectangle { height: 1px; background: Colors.border; }

            // ── LAN sync (crate::sync): the devices this library syncs with,
            // one line each, and the two doors into a new pairing — the
            // announcements the engine hears, or an address typed by hand.
            Text {
                text: "同步";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            // This device's own half. The address is the reason this card
            // exists: pairing by hand means typing this address into the other
            // device, and until now the only way to learn it was to know your
            // own LAN address — the phone's 同步 page shows its own, and this
            // one did not.
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                Text {
                    text: "本机名称";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                    width: 76px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: Theme.spacing-xs;
                        self-name := TextInput {
                            text <=> UIState.sync-self-name;
                            font-family: Typography.ui-font;
                            font-size: Typography.size-ui;
                            color: Colors.text-primary;
                            selection-foreground-color: Colors.text-primary;
                            selection-background-color: Colors.selection;
                            height: 26px;
                            vertical-alignment: center;
                            single-line: true;
                            horizontal-stretch: 1;
                            accepted => {
                                // the name is what the other device's rows say, so
                                // an accepted-but-refused edit must snap back: the
                                // callback re-pushes the session's answer
                                UIState.sync-name-set(UIState.sync-self-name);
                            }
                        }
                        Button {
                            text: "改名";
                            clicked => {
                                UIState.sync-name-set(UIState.sync-self-name);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing-xs;
                        Text {
                            text: "本机地址";
                            font-family: Typography.ui-font;
                            font-size: Typography.size-caption;
                            color: Colors.text-muted;
                            vertical-alignment: center;
                        }
                        Text {
                            text: UIState.sync-self-address == ""
                                ? "未联网 — 其他设备找不到本机"
                                : UIState.sync-self-address;
                            font-family: Typography.mono-font;
                            font-size: Typography.size-caption;
                            color: UIState.sync-self-address == ""
                                ? Colors.text-muted
                                : Colors.text-secondary;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                Text {
                    text: "与本网络上的其他 Quire 设备同步（端口 5878）";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Rectangle {
                    width: 40px;
                    height: 22px;
                    border-radius: 11px;
                    background: UIState.sync-auto ? Colors.accent : Colors.border-strong;
                    animate background { duration: Theme.duration-fast; }
                    TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            UIState.sync-auto = !UIState.sync-auto;
                            UIState.sync-auto-toggled(UIState.sync-auto);
                        }
                    }
                    Rectangle {
                        x: UIState.sync-auto ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: Colors.surface-overlay;
                        animate x { duration: Theme.duration-fast; }
                    }
                }
            }
            // The cadence, as the four settings that make sense on a laptop: a
            // round costs a few milliseconds per device when they are all on the
            // desk, and the wait is what a user notices when it is too slow.
            // Only while auto-sync is on: with the switch off the interval is a
            // number that changes nothing, and a dead control is a question.
            if UIState.sync-auto : HorizontalLayout {
                spacing: Theme.spacing-xs;
                for secs in [30, 60, 300, 1800] : IntervalChip {
                    label: secs == 30 ? "30 秒"
                        : secs == 60 ? "1 分钟"
                        : secs == 300 ? "5 分钟" : "30 分钟";
                    selected: UIState.sync-interval == secs;
                    picked => {
                        UIState.sync-interval-set(secs);
                    }
                }
            }
            for row in UIState.sync-rows : VerticalLayout {
                spacing: 2px;
                Text {
                    text: row.label + (row.online ? " · 在线" : "");
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-primary;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: Theme.spacing-xs;
                    Text {
                        text: row.status;
                        font-family: Typography.ui-font;
                        font-size: Typography.size-caption;
                        color: Colors.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if !row.paired : Button {
                        text: "配对";
                        clicked => {
                            UIState.sync-pair(row.id);
                        }
                    }
                    if row.paired : Button {
                        text: "立即同步";
                        clicked => {
                            UIState.sync-now(row.id);
                        }
                    }
                    Button {
                        text: "忘记";
                        clicked => {
                            UIState.sync-forget(row.id);
                        }
                    }
                }
                // The address it was last reached at. Hand pairing is the only
                // door a network without working broadcasts has, and a round that
                // fails says "the address moved to another device" — a sentence the
                // user can only act on if the number is on the screen.
                if row.paired : Text {
                    text: row.ip;
                    font-family: Typography.mono-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                add-ip := TextInput {
                    text <=> UIState.sync-add-text;
                    font-family: Typography.mono-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-primary;
                    selection-foreground-color: Colors.text-primary;
                    selection-background-color: Colors.selection;
                    horizontal-stretch: 1;
                    height: 26px;
                    vertical-alignment: center;
                    single-line: true;
                    accepted => {
                        UIState.sync-add(UIState.sync-add-text);
                    }
                }
                // TextInput has no placeholder (see CommandPalette): the hint
                // is a Text drawn only while the field is empty
                if UIState.sync-add-text == "" : Text {
                    text: "192.168.1.20 或 192.168.1.20:5878";
                    font-family: Typography.mono-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "按 IP 添加";
                    clicked => {
                        UIState.sync-add(UIState.sync-add-text);
                    }
                }
            }
            if UIState.sync-status != "" : HorizontalLayout {
                spacing: Theme.spacing-xs;
                // A round in flight is a spinner's job, not the sentence's: the
                // status line says what happened, and this says that something
                // is still waiting for an answer. A Text rather than a drawn
                // dot: Rectangle has no vertical-alignment, so a bullet in the
                // row's own font is the only way this sits on the same line.
                if UIState.sync-busy : Text {
                    text: "●";
                    font-size: Typography.size-caption;
                    color: Colors.accent;
                    vertical-alignment: center;
                }
                Text {
                    text: UIState.sync-status;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
            // The log, newest first: "what moved, and what refused" is the one
            // thing a user can check without opening another app, and a failure
            // that only ever lived in the status line was a failure they had to
            // catch happening to see at all.
            Text {
                text: "最近记录";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            if UIState.sync-log.length == 0 : Text {
                text: "还没有记录 — 每一轮同步、配对与失败都会留在这里。";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                wrap: word-wrap;
            }
            for line in UIState.sync-log : HorizontalLayout {
                spacing: Theme.spacing-xs;
                Text {
                    text: line.when;
                    font-family: Typography.mono-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    vertical-alignment: top;
                    width: 68px;
                    overflow: elide;
                }
                Text {
                    text: line.peer;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-secondary;
                    vertical-alignment: top;
                    width: 96px;
                    overflow: elide;
                }
                Text {
                    text: line.message;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: line.ok ? Colors.text-muted : Colors.danger;
                    vertical-alignment: top;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "存储";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                spacing: Theme.spacing-sm;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: "数据文件夹";
                        font-family: Typography.ui-font;
                        font-size: Typography.size-ui;
                        color: Colors.text-secondary;
                    }
                    Text {
                        text: UIState.storage-available ? UIState.data-dir
                            : "内存中运行 — 未挂载数据库";
                        font-family: Typography.mono-font;
                        font-size: Typography.size-caption;
                        color: UIState.storage-available ? Colors.text-primary : Colors.text-muted;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
                // A `visible: false` item keeps its slot in a Slint layout, so
                // these three are conditional children instead: hidden, they
                // still stole width from the label above (it elided two words
                // earlier) and the caption below them still cost a band of
                // empty height — both in sweep17's settings.png.
                if UIState.storage-available : HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    Button {
                        text: "打开文件夹";
                        clicked => {
                            UIState.open-data-folder();
                        }
                    }
                    Button {
                        text: "备份";
                        clicked => {
                            UIState.backup-now();
                        }
                    }
                    Button {
                        text: "清理";
                        clicked => {
                            UIState.reclaim-attachments();
                        }
                    }
                }
            }
            // one line about the only button here that deletes anything: the
            // notice it reports through is a toast, so the rule has to be
            // readable before the click (SPEC §三十七, ADR-0037)
            if UIState.storage-available : Text {
                text: "清理会删除没有被任何块、撤销步骤或复制块引用的图片和文件。";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                wrap: word-wrap;
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "快捷键";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            VerticalLayout {
                // single column: the two-column grid's right column used to
                // escape the card entirely (A4 sweep D2)
                spacing: Theme.spacing-xs;
                ShortcutRow { keys: "Ctrl+K"; label: "命令面板"; }
                ShortcutRow { keys: "Ctrl+P"; label: "搜索页面"; }
                ShortcutRow { keys: "Ctrl+F"; label: "页内查找"; }
                ShortcutRow { keys: "Ctrl+N"; label: "新建页面"; }
                ShortcutRow { keys: "Ctrl+\\"; label: "切换侧边栏"; }
                ShortcutRow { keys: "Ctrl+B / I / E / M"; label: "粗体 / 斜体 / 代码 / 公式"; }
                ShortcutRow { keys: "Tab / Shift+Tab"; label: "缩进 / 取消缩进"; }
                ShortcutRow { keys: "Ctrl+D"; label: "复制块"; }
                ShortcutRow { keys: "Ctrl+S"; label: "立即保存"; }
                ShortcutRow { keys: "Ctrl+= / Ctrl+-"; label: "放大 / 缩小（Ctrl+0 复位）"; }
                ShortcutRow { keys: "Alt+Left / Right"; label: "后退 / 前进"; }
            }

            Rectangle { height: 1px; background: Colors.border; }

            Text {
                text: "关于";
                font-size: Typography.size-caption;
                font-weight: Typography.weight-semibold;
                color: Colors.text-muted;
            }
            HorizontalLayout {
                Text {
                    text: "版本";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle { width: 0px; }
                Text {
                    text: "Quire " + UIState.app-version;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-primary;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                Text {
                    text: "渲染器";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle { width: 0px; }
                Text {
                    text: UIState.renderer-name;
                    font-family: Typography.mono-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-primary;
                    vertical-alignment: center;
                }
            }

            Rectangle { height: Theme.spacing-xs; }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "完成";
                    clicked => {
                        UIState.settings-close-requested();
                    }
                }
            }
            }
        }
    }
}
