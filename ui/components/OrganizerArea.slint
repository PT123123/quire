// SPEC §四十一's second top-level area: 笔记 and 任务.
//
// The shape is activitywatch's task page, ported: **one card**, and inside it
// three columns — the rows themselves, the selected row's *self*, and the nav
// column of views and tags on the **right**. The card is the page: a nav column
// that floated on the window background, a list that had no surface, and a
// detail panel that slid in and out made three unrelated panels out of one
// screen. The two 1px separators are drawn inset rather than bordered, because a
// border on a column would draw a line on all four of its sides.
//
// The nav is the card's *last* column (ADR-0112): 标签 in this area is a filter
// over the list beside it, and the reference puts the filter on the right — the
// side a right-handed pointer reaches without crossing the rows it is filtering.
// The order in this file is the order on screen, which is why the nav block sits
// at the bottom of the layout below.
//
// The rows are Rust's projections (`UIState.note-rows` / `task-rows` /
// `task-list-rows` / `org-board` / `org-tag-rows`) and the panes only place what
// they are handed — every word that is not a row's own text is decided here (the
// smart views' names, the priority glyphs), except the ones that need a clock (a
// relative age, the date "今天") and therefore come from Rust.
//
// What this file deliberately does **not** do: no hover-only affordance whose
// action is unreachable without a mouse, and no keyboard footer — the Android
// shell mounts this same component, where there is no Ctrl and no `↑↓/Enter`
// hints. The panes are side by side here because that is what 1280 px wants;
// that shell's own copy overrides the geometry it needs.
//
// Text fields are **drafts**. The detail pane's fields bind two-way to their own
// `org-*-draft` property and report the *field slot* they belong to
// (`org-field-edited`); Rust commits 300 ms later, exactly as a prose row and a
// database cell do, so one keystroke burst is one undo step instead of one per
// character. A checklist line follows the codebase's one-live-input discipline
// instead — several rows cannot share one draft — so a subtask is *text* until its
// row is clicked, and only that row renders an input.
//
// The magic numbers below are the **slots** the two sides agree on. This Slint
// build has no `const`, so they are literal and named here instead, in both
// directions:
//
//   field slot (`org-field`, `org-field-edited`)
//     1 note title · 2 note body · 3 note tags
//     4 task title · 5 task notes · 6 task tags · 8 task due
//     7 subtask title          (known to Rust as `ORG_FIELD_*`)
//   tab 0 笔记 · 1 任务          (`UIState.org-tab`)
//   view 0 收集箱 · 1 今天 · 2 近七天 · 3 全部 · 4 已完成  (`UIState.org-view`)
//   sort 0 添加顺序 · 1 优先级 · 2 截止日期                      (`UIState.org-sort`)
//   mode 0 列表 · 1 平铺                                       (`UIState.org-mode`)

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { IconButton } from "./IconButton.slint";
import { UIState, BoardCard, BoardColumn, TaskRow } from "../Types.slint";

// ---- local vocabulary ----

// One text button in a row of them (the sorts, the form's choices). `selected`
// is the *one* lit state the whole area uses, so "what am I looking at" reads the
// same wherever it is asked.
component OrgButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> accent: false;
    // The one destructive control in the area (删除任务), drawn the way the
    // reference draws it: outlined in the danger colour rather than filled, so it
    // reads as an action and not as the row's current state.
    in property <bool> danger: false;
    in property <int> color-slot: -1;   // >= 0 draws a palette dot before the label
    // A drawn glyph instead of the label. `✕` (U+2715) is Dingbats and Segoe UI has
    // no glyph for it, so a Text of it is an invisible control whose TouchArea still
    // answers — the exact bug `DatabaseFilterPopup` documents for its delete button.
    in property <string> icon-name: "";
    in property <length> font-size: Typography.size-ui;
    callback clicked();

    height: 26px;
    width: icon-name != "" ? 30px
        : label-text.preferred-width + (color-slot >= 0 ? 30px : 18px);
    border-radius: Theme.radius-sm;
    border-width: root.danger ? 1px : 0px;
    border-color: Colors.danger;
    background: selected
        ? Colors.surface-selected
        : (ta.has-hover ? Colors.hover-fill : transparent);
    animate background { duration: Theme.duration-instant; }

    if color-slot >= 0 : Rectangle {
        x: 7px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Colors.block-text(color-slot);
    }
    label-text := Text {
        x: color-slot >= 0 ? 21px : 9px;
        width: parent.width - self.x - 9px;
        height: parent.height;
        text: root.label;
        visible: root.icon-name == "";
        font-family: Typography.ui-font;
        font-size: root.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.danger ? Colors.danger
            : (root.selected ? Colors.text-primary
            : (root.accent ? Colors.accent-text : Colors.text-secondary));
        overflow: elide;
    }
    if root.icon-name != "" : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        size: 13px;
        name: root.icon-name;
        color: Colors.text-secondary;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// A field's label, to the left of its control.
component OrgField inherits Text {
    in property <string> name;
    text: root.name;
    font-family: Typography.ui-font;
    font-size: Typography.size-caption;
    color: Colors.text-muted;
    vertical-alignment: center;
    overflow: elide;
}

// One row of 详细信息. The label is the reference's word and the value is text
// Rust already decided, so this row never computes anything — it places two
// strings and elides the one that can be long (a note's tag list).
component OrgDetailRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    height: 22px;
    spacing: 8px;
    cross-axis-alignment: center;
    OrgField { name: root.label; width: 40px; }
    Text {
        text: root.value;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }
}

// One row of the nav column: the icon-less view rows, and the lists below them.
// 34 px rather than the page's list height — a nav is scanned, not read, and a
// selected row says so three ways (fill, left bar, weight) so no one cue has to
// carry it alone.
//
// A **tag** row is also the 反向筛选 control: the circled slash at its right edge
// hides this path — and everything under it — or stops hiding it. Drawn and not
// typed, because `⊘` is not in this app's font chain (the trap the bar's `✕`
// fell into): a `Text` of a glyph no face carries is an invisible control whose
// `TouchArea` still answers. The slash is two `Rectangle`s, so it renders
// whatever the machine's fonts are.
component OrgNavRow inherits Rectangle {
    in property <string> label;
    in property <int> count: -1;        // < 0 paints no count
    in property <int> color-slot: -1;   // >= 0 draws the list's dot
    in property <bool> selected: false;
    in property <bool> accent: false;
    // This row is a tag path that can be hidden, and whether it is hidden now.
    in property <bool> excludable: false;
    in property <bool> excluded: false;
    // A stored list row: its ⋯ opens the shared context menu (rename / colour /
    // delete), and it can be renamed inline — the sidebar's own idiom, kept in the
    // row it renames rather than in a dialog.
    in property <bool> menuable: false;
    in property <bool> renaming: false;
    callback clicked();
    callback exclude-toggled();
    callback menu-requested(length, length);
    callback rename-committed(string);
    callback rename-cancelled();

    height: 32px;
    border-radius: Theme.radius-sm;
    background: selected
        ? Colors.surface-selected
        : (ta.has-hover ? Colors.hover-fill : transparent);
    animate background { duration: Theme.duration-instant; }

    // What the text must leave room for: the count, then the exclude control, then
    // the ⋯. One property rather than three subtractions, because a `Text`'s width
    // is a `length` and nesting the arithmetic inside it is how a row elides to "…".
    private property <length> right-inset:
        (count > 0 ? count-text.preferred-width + 16px : 13px)
        + (excludable ? 24px : 0px)
        + (menuable ? 22px : 0px);

    if selected : Rectangle {
        x: 0;
        y: 7px;
        width: 3px;
        height: parent.height - 14px;
        border-radius: 2px;
        background: Colors.accent;
    }
    if color-slot >= 0 : Rectangle {
        x: 13px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Colors.block-text(color-slot);
    }
    nav-text := Text {
        x: color-slot >= 0 ? 29px : 13px;
        width: parent.width - self.x - root.right-inset;
        height: parent.height;
        // The rename input takes this slot's place while it is up, so a renamed
        // row is one row and not a row with a second copy of its name under it.
        visible: !root.renaming;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        font-weight: root.selected ? Typography.weight-semibold : Typography.weight-regular;
        color: root.excluded ? Colors.text-muted
            : (root.accent ? Colors.accent-text
            : (root.selected ? Colors.text-primary : Colors.text-secondary));
        vertical-alignment: center;
        overflow: elide;
    }
    count-text := Text {
        x: parent.width - count-text.width - (root.excludable ? 26px : 12px)
            - (root.menuable ? 22px : 0px);
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        visible: root.count > 0 && !root.renaming;
        text: root.count;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: Colors.text-muted;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    // Last, so it is *above* `ta`: a control under the row's own hit area is a
    // control that cannot be clicked.
    //
    // A circled bar rather than the reference's `⊘`: this build's Slint has no
    // `rotation-angle` on a `Rectangle`, so a slashed circle would have to be a
    // rotated rectangle it cannot draw or a `Text` of a glyph this font chain does
    // not carry. 减 is the same idea in a shape that renders everywhere.
    if root.excludable : Rectangle {
        x: parent.width - 21px;
        y: (parent.height - 17px) / 2;
        width: 17px;
        height: 17px;
        border-radius: 8.5px;
        border-width: 1px;
        border-color: root.excluded ? Colors.danger : Colors.border-strong;
        background: root.excluded ? Colors.danger.with-alpha(0.12)
            : (excl-ta.has-hover ? Colors.hover-fill : transparent);
        Rectangle {
            x: (parent.width - 9px) / 2;
            y: (parent.height - 1.5px) / 2;
            width: 9px;
            height: 1.5px;
            background: root.excluded ? Colors.danger : Colors.text-muted;
        }
        excl-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.exclude-toggled(); }
        }
    }
    // The ⋯ that opens the shared context menu — 重命名 / 颜色 / 删除清单. Drawn on
    // hover or when the row is the selected one, the way a task row's own ⋯ is, and
    // after `ta` so it is *above* the row's hit area.
    if root.menuable : IconButton {
        x: parent.width - self.width - 3px;
        y: (parent.height - self.height) / 2;
        icon-name: "dots-horizontal";
        icon-color: Colors.text-muted;
        size: 20px;
        visible: !root.renaming && (ta.has-hover || root.selected);
        clicked => {
            root.menu-requested(self.absolute-position.x, self.absolute-position.y);
        }
    }
    // Inline rename, the sidebar's own shape: Enter commits, Escape puts the old
    // name back. Above `ta`, because a field under the row's own hit area is a
    // field nobody can type into.
    if root.renaming : Rectangle {
        x: nav-text.x;
        y: (parent.height - 22px) / 2;
        width: parent.width - self.x - 13px;
        height: 22px;
        border-radius: Theme.radius-xs;
        background: Colors.background;
        border-width: 1px;
        border-color: Colors.accent;
        rename := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            vertical-alignment: center;
            font-family: Typography.ui-font;
            font-size: Typography.size-ui;
            color: Colors.text-primary;
            selection-foreground-color: Colors.text-primary;
            selection-background-color: Colors.selection;
            single-line: true;
            text: root.label;
            accepted => { root.rename-committed(self.text); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.rename-cancelled();
                    accept
                } else {
                    reject
                }
            }
            init => {
                rename.focus();
                rename.select-all();
            }
        }
    }
}

// The tag column's whole content, so the two tabs share one implementation: the
// filter is the same question asked of whichever half is showing (the notes'
// tags or the tasks'), and a second copy of this would be a second set of rules
// about include, exclude and 清除筛选.
//
// 全部笔记 is deliberately *not* here — the 笔记 tab's own row above says it, and
// the tasks' smart views are where "everything" lives for that half.
component OrgTagColumn inherits VerticalLayout {
    spacing: 1px;

    // The way back up a level, and the path being filtered. A tag is a path, so
    // the column shows one level at a time: 项目 → 工作 → ActivityWatch is three
    // taps and this row is the way out of a wrong one.
    if UIState.org-tag != "" : OrgNavRow {
        label: "↑ 上级";
        count: -1;
        clicked => { UIState.org-tag-picked(UIState.org-tag-parent); }
    }
    Rectangle { height: 8px; }
    // The path being filtered, as a breadcrumb, and — under it — the paths being
    // *hidden*. Wrapped in a plate because a width inside the layout would be a
    // binding loop, and an elided path needs one.
    Rectangle {
        height: 22px;
        Text {
            x: 13px;
            width: parent.width - 26px;
            height: parent.height;
            text: UIState.org-tag == "" ? "标签" : UIState.org-tag-label;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if UIState.org-excluded-label != "" : Rectangle {
        height: 22px;
        Text {
            x: 13px;
            width: parent.width - 26px;
            height: parent.height;
            text: UIState.org-excluded-label;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.danger;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    // One door out of both halves of the filter, and it exists only when there is
    // something to clear: a "clear" that clears nothing is noise in a nav.
    if UIState.org-tag != "" || UIState.org-excluded-label != "" : OrgNavRow {
        label: "清除筛选";
        count: -1;
        accent: true;
        clicked => { UIState.org-filters-cleared(); }
    }
    for tag[i] in UIState.org-tag-rows : OrgNavRow {
        label: tag.name;
        count: tag.count;
        excludable: true;
        excluded: tag.excluded;
        // A chip shows the level *below* the filter, so it is never the selected
        // one — the row above it says where the filter is.
        selected: false;
        clicked => { UIState.org-tag-picked(tag.path); }
        exclude-toggled => { UIState.org-tag-excluded(tag.path); }
    }
}

// One pill of the 笔记 half's filter bar (ADR-0118). `OrgNavRow` is a full-width
// row with a left selection bar and a ⋯ — right for a nav column, wrong for a row
// of chips over a list that owns its card. This is that row's chip-sized twin: a
// label, the count it would leave, and the same ⊖ for 反向筛选.
component OrgFilterChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> accent: false;
    in property <bool> excluded: false;
    // A tag chip carries the filter's other half; 全部笔记 / 回收站 / 清除筛选 do not.
    in property <bool> excludable: false;
    callback clicked();
    callback exclude-toggled();

    height: 24px;
    max-width: 100000px;
    border-radius: 12px;
    border-width: 1px;
    // **A selected chip is a state, not an emphasis.** It used to be a blue
    // plate with a saturated blue border and blue text on that plate — three
    // signals at once, for the one thing the user already knows, because 全部笔记
    // is lit by default. Selected is now the surface one step up from the page,
    // with the border that already separates every unselected chip, and the label
    // in the text colour rather than the accent's. The accent keeps its job:
    // things that want attention now (a round in flight) rather than a filter
    // that is simply on.
    border-color: root.excluded
        ? Colors.danger
        : root.selected || root.accent ? Colors.border-strong : Colors.border;
    background: root.excluded
        ? Colors.danger.with-alpha(0.12)
        : root.selected || root.accent
        ? Colors.surface-hover
        : (ta.has-hover ? Colors.hover-fill : Colors.background);
    animate background { duration: Theme.duration-instant; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: root.excludable ? 4px : 10px;
        spacing: 4px;
        Text {
            text: root.label;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: root.excluded ? Colors.danger
                : root.selected || root.accent ? Colors.text-primary
                : Colors.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }
        // The ⊖, the same shape and the same job as `OrgNavRow`'s: this build's
        // Slint has no `rotation-angle`, so a slashed circle is a minus in a ring.
        if root.excludable : Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.excluded ? Colors.danger : Colors.border-strong;
            background: root.excluded ? Colors.danger.with-alpha(0.12)
                : (excl-ta.has-hover ? Colors.hover-fill : transparent);
            Rectangle {
                x: (parent.width - 8px) / 2;
                y: (parent.height - 1.5px) / 2;
                width: 8px;
                height: 1.5px;
                background: root.excluded ? Colors.danger : Colors.text-muted;
            }
            excl-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.exclude-toggled(); }
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// The toolbar's segmented control (列表 / 平铺). Two states, one box: the lit half
// is the answer, and the box itself is what says the two are alternatives.
component OrgSeg inherits Rectangle {
    in property <int> selected: 0;
    in property <[string]> labels: ["列表", "平铺"];
    callback picked(int);

    height: 26px;
    width: root.labels.length * 52px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Colors.border;
    background: transparent;
    clip: true;

    HorizontalLayout {
        for label[i] in root.labels : Rectangle {
            background: root.selected == i ? Colors.surface-selected : transparent;
            animate background { duration: Theme.duration-instant; }
            Text {
                text: label;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.selected == i ? Colors.text-primary : Colors.text-muted;
            }
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.picked(i); }
            }
        }
    }
}

// The checkbox in front of a task and of a checklist line. A `Rectangle` and an
// `Icon` rather than a widget: this codebase has no checkbox control, and the
// to-do block's own box is drawn the same way. `round` is the task row's own
// shape — a circle, the way activitywatch's task page draws it.
component OrgCheck inherits Rectangle {
    in property <bool> checked: false;
    in property <length> box-size: 16px;
    in property <bool> round: false;
    callback toggled();

    width: box-size;
    height: box-size;
    border-radius: round ? box-size / 2 : 4px;
    background: checked ? Colors.accent : transparent;
    border-width: 1.5px;
    border-color: checked ? Colors.accent : Colors.border-strong;

    if checked : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.box-size - 6px;
        height: root.box-size - 6px;
        name: "todo-check";
        size: root.box-size - 5px;
        color: Colors.text-on-accent;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(); }
    }
}

// A row's tags and its age, on one muted line. Both are already-joined strings —
// a delegate never does string work in this codebase.
component OrgMeta inherits Text {
    in property <string> tags;
    in property <string> when;
    text: root.tags != "" && root.when != "" ? root.tags + " · " + root.when
        : (root.tags != "" ? root.tags : root.when);
    font-family: Typography.ui-font;
    font-size: Typography.size-caption;
    color: Colors.text-muted;
    vertical-alignment: center;
    overflow: elide;
}

// One tag as a pill. `List ` + `tag` in the toolbar of activitywatch's page; here
// it is also how a row says which list it is in, which is why the tint is a
// property rather than a constant.
component OrgPill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Colors.text-secondary;

    height: 17px;
    width: pill-text.preferred-width + 14px;
    border-radius: 9px;
    background: Colors.hover-fill;
    pill-text := Text {
        x: 7px;
        width: parent.width - 14px;
        height: parent.height;
        text: root.text;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: root.tint;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A priority, as the glyph activitywatch's task page uses: ▲ ◆ ▼ in the danger /
// accent / success colour, and nothing at all for "无". Four rows reading "高" is
// a column of noise; the word belongs in the detail panel, where it is a choice.
component OrgPrio inherits Text {
    in property <int> slot: 0;   // Priority slot: 0 none, 1 low, 2 medium, 3 high
    visible: root.slot > 0;
    width: 14px;
    horizontal-alignment: center;
    vertical-alignment: center;
    text: root.slot == 3 ? "▲" : (root.slot == 2 ? "◆" : "▼");
    font-family: Typography.ui-font;
    font-size: Typography.size-caption;
    font-weight: Typography.weight-bold;
    color: root.slot == 3 ? Colors.danger
        : (root.slot == 2 ? Colors.accent-text : Colors.success);
}

// A deadline as a badge: boxed, so a date in a row of dates reads as one thing.
component OrgDue inherits Rectangle {
    in property <string> label;
    in property <bool> overdue: false;
    in property <bool> today: false;
    visible: root.label != "";

    height: 18px;
    width: due-text.preferred-width + 12px;
    border-radius: 9px;
    border-width: 1px;
    border-color: root.overdue ? Colors.danger : Colors.border;
    background: root.overdue ? Colors.danger.with-alpha(0.10) : transparent;
    due-text := Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.label;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: root.overdue ? Colors.danger
            : (root.today ? Colors.accent-text : Colors.text-muted);
        vertical-alignment: center;
        horizontal-alignment: center;
        overflow: elide;
    }
}

// One task as the list paints it: 52 px, because a row carries a title *and* a
// line of pills and 42 could not hold both. The whole row is the click target
// for selection; only the box toggles, and only the ⋯ opens the menu.
component OrgTaskRow inherits Rectangle {
    in property <TaskRow> task;
    callback toggled();
    callback opened();
    callback menu-requested(length, length);

    height: 52px;
    border-radius: Theme.radius-md;
    background: task.selected || task.picked
        ? Colors.surface-selected
        : (ta.has-hover ? Colors.hover-fill : transparent);
    animate background { duration: Theme.duration-instant; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        OrgCheck {
            // One box, two meanings: the row's done state normally, and the pick
            // while 多选 is on (ADR-0111) — the same box the reference swaps in
            // front of the same row. Which of the two a click means is Rust's
            // decision, so the callback is the one `toggled` already is.
            checked: UIState.org-selecting ? task.picked : task.done;
            box-size: 18px;
            round: !UIState.org-selecting;
            toggled => { root.toggled(); }
        }
        VerticalLayout {
            // The row's own growing column: everything else in the row is a
            // fixed-size control, and this is what takes the width left over.
            // `max-width` earns its place here for the reason the area's own
            // comment gives — a container of elidable text has a small preferred
            // width and no ceiling above it without this line.
            vertical-stretch: 1;
            horizontal-stretch: 1;
            max-width: 100000px;
            alignment: center;
            spacing: 3px;
            Text {
                text: task.title != "" ? task.title : "无标题";
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                color: task.done ? Colors.text-muted : Colors.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                // The pills line is dropped whole when it is empty, so a row
                // without tags is one line of text rather than a gap.
                visible: task.tag-list.length > 0 || task.list > 0
                    || task.subtasks-total > 0;
                height: 17px;
                spacing: 6px;
                if task.list > 0 : OrgPill {
                    text: task.list-name;
                    tint: Colors.block-text(task.list-color);
                }
                for tag[i] in task.tag-list : OrgPill { text: tag; }
                if task.subtasks-total > 0 : Text {
                    text: "☑ " + task.subtasks-done + "/" + task.subtasks-total;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    vertical-alignment: center;
                }
            }
        }
        OrgPrio { slot: task.priority; }
        OrgDue {
            label: task.due-label;
            overdue: task.overdue;
            today: task.due == UIState.org-today;
        }
        if task.list > 0 : Rectangle {
            width: 9px;
            height: 9px;
            border-radius: 4.5px;
            background: Colors.block-text(task.list-color);
        }
        IconButton {
            icon-name: "dots-horizontal";
            icon-color: Colors.text-muted;
            size: 24px;
            // Gone while picking: every action it offers is one the bar has, and
            // a row menu over a row that is already a checkbox is two answers to
            // the same question. Gone in the bin as well, where the two verbs are
            // drawn instead — a menu that holds only 恢复 and 彻底删除 is a menu
            // that costs a click to say what a button already says.
            visible: !UIState.org-selecting && !UIState.org-bin-open;
            opacity: ta.has-hover || task.selected ? 1 : 0;
            clicked => {
                root.menu-requested(self.absolute-position.x, self.absolute-position.y);
            }
        }
        // 回收站: a binned task's own two verbs, in the row.
        if UIState.org-bin-open : OrgButton {
            label: "恢复";
            font-size: Typography.size-caption;
            clicked => { UIState.org-bin-restored(task.id); }
        }
        if UIState.org-bin-open : OrgButton {
            label: "彻底删除";
            font-size: Typography.size-caption;
            danger: true;
            clicked => { UIState.org-bin-purged(task.id); }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.opened(); }
    }
}

// The list's quick-add line. Enter commits — this is the one input in the area
// that is *not* a 300 ms draft, because a created row is a step and half a row
// is not. The trailing hint is the desktop's; the touch copy drops it.
component OrgQuickAdd inherits Rectangle {
    in property <string> placeholder;
    // The keyboard hint is the desktop's, and it is a *property* so the board's
    // columns can ask for none: 回车创建 under a ＋ line already says it, and the
    // touch copy of this component drops every such hint (SPEC §四十一).
    in property <string> hint: "回车创建";
    in-out property <string> value;
    callback submitted();

    height: 36px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: ta.has-hover || input.has-focus ? Colors.border-strong : Colors.border;
    background: Colors.surface-hover;

    if root.value == "" : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-muted;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 11px;
        y: 7px;
        width: parent.width - (hint.visible ? hint.width + 32px : 22px);
        height: parent.height - 14px;
        text <=> root.value;
        single-line: true;
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-primary;
        vertical-alignment: center;
        selection-foreground-color: Colors.text-on-accent;
        selection-background-color: Colors.selection;
        accepted => { root.submitted(); }
    }
    hint := Text {
        x: parent.width - hint.width - 10px;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        visible: root.hint != "" && root.value == "";
        text: root.hint;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: Colors.text-muted;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
}

// One card of the board. Drag it to another column to move it there — the same
// drag the page tree and the document's rows use, so a card lifts the way every
// other draggable thing in this app lifts.
component OrgBoardCard inherits Rectangle {
    in property <BoardCard> card;
    callback toggled();
    callback opened();

    height: card-text.preferred-height + (card.tag-list.length > 0 ? 24px : 0px) + 38px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: ta.has-hover ? Colors.border-strong : Colors.border;
    background: Colors.surface;
    animate border-color { duration: Theme.duration-instant; }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            OrgCheck {
                checked: card.done;
                box-size: 16px;
                toggled => { root.toggled(); }
            }
            card-text := Text {
                text: card.title != "" ? card.title : "无标题";
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                color: Colors.text-primary;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            OrgPrio { slot: card.priority; }
        }
        if card.tag-list.length > 0 : HorizontalLayout {
            height: 17px;
            spacing: 6px;
            for tag[i] in card.tag-list : OrgPill { text: tag; }
        }
        HorizontalLayout {
            height: 18px;
            spacing: 6px;
            OrgDue {
                label: card.due-label;
                overdue: card.overdue;
                today: card.due == UIState.org-today;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    drag := DragArea {
        enabled: true;
        allow-move: true;
        data: UIState.org-card-payload(card.id);
        drag-finished => { UIState.org-drop-list = -2; }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.opened(); }
    }
}

// One column of the board: the list, its count, its open tasks, and the ＋ line
// that adds straight into it.
component OrgBoardColumn inherits Rectangle {
    in property <BoardColumn> column;
    callback card-toggled(int);
    callback card-opened(int);
    callback added(string);
    // One draft per column would need one draft per column *id*; a single one is
    // shared because only one column's ＋ line can have focus at a time.
    property <string> add-draft: "";

    // 232 rather than 268 so three columns fit the list column's 442 px beside
    // them: a board that always scrolls sideways is a board nobody scans.
    min-width: 232px;
    max-width: 232px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: UIState.org-drop-list == column.id
        ? Colors.accent
        : (ta.has-hover ? Colors.border-strong : Colors.border);
    background: Colors.background;
    animate border-color { duration: Theme.duration-fast; }

    // Declared first, so it is *under* the column's own content: it exists for
    // `has-hover` only, and a hit area above the cards is a column nobody can
    // click into.
    ta := TouchArea { }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            height: 22px;
            spacing: 8px;
            if column.color >= 0 : Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 3px;
                background: Colors.block-text(column.color);
            }
            Text {
                text: column.name;
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                font-weight: Typography.weight-semibold;
                color: Colors.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: column.count;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        ListView {
            vertical-stretch: 1;
            for entry[i] in column.cards : OrgBoardCard {
                card: entry;
                toggled => { root.card-toggled(entry.id); }
                opened => { root.card-opened(entry.id); }
            }
        }
        OrgQuickAdd {
            placeholder: "＋ 添加任务";
            hint: "";
            value <=> root.add-draft;
            submitted => {
                if (root.add-draft != "") { root.added(root.add-draft); }
                root.add-draft = "";
            }
        }
    }
    // The drop target is last, so it is *above* the content: a `DropArea` only
    // reacts to a drag (normal clicks pass straight through).
    DropArea {
        can-drop(event) => {
            if (UIState.org-card-hover(event.data, column.id)) {
                DragAction.move
            } else {
                DragAction.none
            }
        }
        dropped(event) => {
            UIState.org-card-dropped(event.data, column.id);
            DragAction.move
        }
    }
}

// One text field of the detail pane. No border until it has focus, because a page
// of eight boxed fields is a form and this is a page.
component OrgInput inherits Rectangle {
    in property <string> placeholder;
    in property <bool> multiline: false;
    in property <length> font-size: Typography.size-ui;
    // NB: not `min-height` — that one is the layout's own property on a
    // `Rectangle`, and overriding it is an error.
    in property <length> hint-height: 28px;
    in-out property <string> value;
    // Whether the field takes the row's leftover width. A `Rectangle` has no
    // preferred width of its own, so this is min/max *plus* stretch — and **not**
    // an explicit `width`. An explicit width wins over the stretch, which is what
    // `width: root.grow ? 0px : root.field-width` did: every growing field in the
    // detail pane came out zero pixels wide, and the sweep photographed a task
    // with no title, no tags and no notes. (The fixed-width arm still wants it,
    // which is why min and max are both set there.)
    in property <bool> grow: true;
    in property <length> field-width: 170px;
    callback edited();
    callback accepted();

    min-width: root.grow ? 120px : root.field-width;
    max-width: root.grow ? 100000px : root.field-width;
    horizontal-stretch: root.grow ? 1 : 0;
    height: multiline
        ? max(root.hint-height, inner.preferred-height + 12px)
        : max(root.hint-height, 32px);
    border-radius: Theme.radius-sm;
    background: inner.has-focus
        ? Colors.background
        : (hover.has-hover ? Colors.hover-fill : transparent);

    // Declared first, so it is *under* the text: it exists for the hover fill
    // only, and a TouchArea above an input is an input nobody can click into.
    hover := TouchArea { }
    // The placeholder. Slint's `TextInput` has none, and an empty field with no
    // hint is a field nobody knows what to type into. Also under the input, and
    // text takes no clicks of its own.
    if root.value == "" : Text {
        x: 8px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        text: root.placeholder;
        font-family: Typography.ui-font;
        font-size: root.font-size;
        color: Colors.text-muted;
        vertical-alignment: root.multiline ? top : center;
        overflow: elide;
    }
    inner := TextInput {
        x: 6px;
        y: 5px;
        width: parent.width - 12px;
        height: parent.height - 10px;
        text <=> root.value;
        wrap: root.multiline ? word-wrap : no-wrap;
        font-family: Typography.ui-font;
        font-size: root.font-size;
        color: Colors.text-primary;
        selection-foreground-color: Colors.text-on-accent;
        selection-background-color: Colors.selection;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
}

export component OrganizerArea inherits Rectangle {
    // Transparent for the same reason as the editor: the window's `Colors.page`
    // ramp is the backdrop, so the gradient runs behind the organizer too.
    background: transparent;
    // `horizontal-stretch` alone does **not** grow this area, and the reason is
    // worth the two lines: a `Rectangle` whose content is a layout takes its
    // `max-width` from that layout's preferred width, so the stretch factor has
    // no room above the ceiling to distribute. With the ceiling left alone the
    // area came out 885 px wide (its own 208 + 1 + rows + 1 + 340), the 340 px
    // detail panel started at x = 677, the list beside it was squeezed to 239 px,
    // and every task title elided to "今天…". The editor never showed it because
    // its preferred width is already the width of the window.
    //
    // This is the same rule `OrgInput` learned for its growing fields: min/max
    // *plus* stretch. Everything that has to take the leftover width here says
    // it the same way.
    horizontal-stretch: 1;
    max-width: 100000px;

    // The chips' own words, in Rust's slot order: the smart views
    // (`State::SMART_*`) and the repeat rules (`Repeat::ALL`). Names live here
    // because they are the UI's words; the *predicate* behind a smart view is
    // Rust's, and the *slot* is what the two sides agree on.
    // 已完成 is deliberately not in this list: it is the nav's bottom row, so the
    // four above it are the views a task can be *in*.
    property <[string]> smart-names: ["收集箱", "今天", "最近 7 天", "全部"];
    property <[string]> priority-names: ["无", "低", "中", "高"];
    property <[string]> repeat-names: ["不重复", "每天", "工作日", "每周", "每月"];
    property <[string]> sort-names: ["添加顺序", "优先级", "截止日期"];

    HorizontalLayout {
        padding: 14px;
        spacing: 0px;

        // ── the one card ───────────────────────────────────────────────────
        Rectangle {
            horizontal-stretch: 1;
            max-width: 100000px;
            background: Colors.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Colors.border;

            HorizontalLayout {
                spacing: 0px;

                // ── the list column (or the board) ──────────────────────────
                Rectangle {
                    horizontal-stretch: 1;
                    max-width: 100000px;
                    clip: true;

                    VerticalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 12px;
                        padding-bottom: 10px;
                        spacing: 10px;

                        // the header: what is showing, how many, and the two
                        // ways of looking at it. While 多选 is on, the bar in
                        // SPEC §四十一 / ADR-0111 replaces this row entirely — the
                        // view's title and its counts are not the question being
                        // asked any more.
                        if !UIState.org-selecting : HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            Text {
                                text: UIState.org-view-title;
                                font-family: Typography.ui-font;
                                font-size: Typography.size-ui-lg;
                                font-weight: Typography.weight-semibold;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                            Text {
                                text: UIState.org-view-count-label;
                                font-family: Typography.ui-font;
                                font-size: Typography.size-caption;
                                color: Colors.text-muted;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // 回收站's own verb: the whole half on screen, purged as
                            // one undoable step. Drawn only while the bin is open —
                            // a "clear the bin" button over a list of notes is a
                            // button nobody can explain.
                            if UIState.org-bin-open : OrgButton {
                                label: "清空回收站";
                                font-size: Typography.size-caption;
                                danger: true;
                                clicked => { UIState.org-bin-emptied(); }
                            }
                            // 指令: the door an AI's answer comes back through. Next
                            // to 多选 because they are the two ways this page is
                            // written to in bulk — one by hand, one by pasting what
                            // 复制 sent out. Both tabs have it: the batches differ but
                            // the door does not.
                            // Neither is offered while the bin is open: 指令 edits
                            // rows on a list and 多选 picks a set of them, and a bin
                            // is neither. 清空回收站 above is the bin's own bulk verb.
                            if (UIState.org-tab == 0 || UIState.org-mode == 0) && !UIState.org-bin-open : OrgButton {
                                label: "指令…";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-command-opened(UIState.org-tab); }
                            }
                            // The door to 多选. The reference opens it with a long
                            // press, which this window has no gesture for; a
                            // button is the desktop's answer, and it is also the
                            // only door the 笔记 tab has — a note row has no ⋯.
                            if (UIState.org-tab == 0 || UIState.org-mode == 0) && !UIState.org-bin-open : OrgButton {
                                label: "多选";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-select-entered(UIState.org-tab); }
                            }
                            // 刷新: a round with every paired device, right now.
                            // It is the only button in this row that leaves the
                            // app — everything else edits what is on screen —
                            // and it is here rather than only in the settings
                            // dialog because that is where a note is read *and*
                            // written, so a row that arrived from another device
                            // while you were in the list is the moment the button
                            // is worth pressing. Drawn only with a device to dial:
                            // a 刷新 that can only say "还没有别的设备" is a
                            // button in the way.
                            if UIState.sync-has-peers : OrgButton {
                                label: "刷新";
                                font-size: Typography.size-caption;
                                clicked => { UIState.sync-now-all(); }
                            }
                            // 列表/平铺 says nothing about a bin, so the segmented
                            // control goes with it.
                            if UIState.org-tab == 1 && !UIState.org-bin-open : OrgSeg {
                                selected: UIState.org-mode;
                                picked(m) => { UIState.org-mode-picked(m); }
                            }
                        }

                        if UIState.org-selecting : HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            // The count first, and it is one line rather than the
                            // view's title: while picking, "how many have I got"
                            // is the only heading that means anything.
                            Text {
                                text: "已选 " + UIState.org-selection-count + " 项";
                                font-family: Typography.ui-font;
                                font-size: Typography.size-ui-lg;
                                font-weight: Typography.weight-semibold;
                                color: Colors.text-primary;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // 全选 or 取消全选, read off the two numbers the models
                            // already carry: the set's size against the rows on
                            // screen. Which of the two this is stays Rust's call.
                            OrgButton {
                                label: UIState.org-selection-count > 0
                                    && UIState.org-selection-count >= (UIState.org-tab == 0
                                        ? UIState.note-rows.length
                                        : UIState.task-rows.length)
                                    ? "取消全选" : "全选";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-select-all-toggled(); }
                            }
                            // 复制 is both halves': the notes send their bodies with
                            // their 唯一 IDs, the tasks their titles and 备注 with the
                            // same — the ID is what lets the answer name the row.
                            OrgButton {
                                label: "复制";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-selection-verbed(0); }
                            }
                            if UIState.org-tab == 1 : OrgButton {
                                label: "完成";
                                font-size: Typography.size-caption;
                                clicked => { UIState.org-selection-verbed(1); }
                            }
                            OrgButton {
                                label: "删除";
                                font-size: Typography.size-caption;
                                danger: true;
                                clicked => { UIState.org-selection-verbed(2); }
                            }
                            OrgButton {
                                // Drawn, not typed: see OrgButton's `icon-name`.
                                icon-name: "x";
                                clicked => { UIState.org-select-stopped(); }
                            }
                        }

                        // ── the 笔记 half's filter bar (ADR-0118) ────────────
                        // What the removed nav column carried, in the one place a
                        // list that owns its card can put it: the needle, the tag
                        // chips (the level under the current path, 反向筛选 and
                        // all), and the 回收站 door. A row of its own rather than a
                        // third header line, so the title row stays the same shape
                        // on both halves.
                        if UIState.org-tab == 0 && !UIState.org-selecting : HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            OrgInput {
                                grow: false;
                                field-width: 170px;
                                hint-height: 30px;
                                placeholder: "搜索笔记";
                                value <=> UIState.org-query;
                                edited => { UIState.org-query-changed(); }
                            }
                            // The bin is not a filter over the live notes, so the
                            // chips go with it (the Android copy's own rule): its
                            // counts are drawn from the other half of the catalog.
                            if !UIState.org-bin-open : ScrollView {
                                height: 30px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    // one level down the ↑ chip says where the
                                    // filter is *and* is the way out of it
                                    if UIState.org-tag != "" : OrgFilterChip {
                                        label: "↑ " + UIState.org-tag-label;
                                        selected: true;
                                        clicked => { UIState.org-tag-picked(UIState.org-tag-parent); }
                                    }
                                    if UIState.org-tag == "" : OrgFilterChip {
                                        label: "全部笔记";
                                        selected: true;
                                        clicked => { UIState.org-tag-picked(""); }
                                    }
                                    for tag[i] in UIState.org-tag-rows : OrgFilterChip {
                                        label: "#" + tag.name + "  " + tag.count;
                                        excludable: true;
                                        excluded: tag.excluded;
                                        clicked => { UIState.org-tag-picked(tag.path); }
                                        exclude-toggled => { UIState.org-tag-excluded(tag.path); }
                                    }
                                    if UIState.org-excluded-label != "" : OrgFilterChip {
                                        label: UIState.org-excluded-label;
                                        excluded: true;
                                    }
                                    if UIState.org-tag != "" || UIState.org-excluded-label != "" : OrgFilterChip {
                                        label: "清除筛选";
                                        accent: true;
                                        clicked => { UIState.org-filters-cleared(); }
                                    }
                                }
                            }
                            if UIState.org-bin-open : Rectangle { horizontal-stretch: 1; }
                            OrgFilterChip {
                                // The count only when there is one: the nav row this
                                // replaces hid a zero too, and "回收站 0" reads like a
                                // filter that found nothing rather than a place.
                                label: "回收站" + (UIState.org-bin-note-count > 0
                                    ? "  " + UIState.org-bin-note-count
                                    : "");
                                selected: UIState.org-bin-open;
                                clicked => { UIState.org-bin-toggled(); }
                            }
                        }

                        // 回收站 is a mode *over* the list, so it takes the list's
                        // branch whatever 列表/平铺 says: a bin is not a kanban, and
                        // the board draws no binned cards anyway (`org_board_rows`
                        // reads the live half).
                        if UIState.org-tab == 1 && (UIState.org-mode == 0 || UIState.org-bin-open) : VerticalLayout {
                            spacing: 8px;
                            vertical-stretch: 1;

                            // Adding into a bin and sorting one are both questions
                            // about a *list*, so neither is offered while the bin is
                            // open — the row is there for the list it belongs to.
                            if !UIState.org-bin-open : OrgQuickAdd {
                                placeholder: "添加任务到「" + UIState.org-view-title + "」…";
                                value <=> UIState.org-quick-add;
                                submitted => { UIState.org-quick-add-submitted(); }
                            }

                            if !UIState.org-bin-open : HorizontalLayout {
                                height: 24px;
                                spacing: 4px;
                                OrgField { name: "排序"; width: 28px; }
                                for name[i] in root.sort-names : OrgButton {
                                    label: name;
                                    font-size: Typography.size-caption;
                                    selected: UIState.org-sort == i;
                                    clicked => { UIState.org-sort-picked(i); }
                                }
                            }

                            ListView {
                                vertical-stretch: 1;
                                for entry[i] in UIState.task-rows : OrgTaskRow {
                                    task: entry;
                                    toggled => { UIState.org-task-done-toggled(entry.id); }
                                    opened => { UIState.org-task-selected(entry.id); }
                                    menu-requested(x, y) => {
                                        UIState.org-task-menu-requested(entry.id, x, y);
                                    }
                                }
                            }

                            // the footer: the switch that reveals the finished
                            // ones, and the whole area's progress
                            Rectangle {
                                height: 34px;
                                Rectangle {
                                    y: 0;
                                    height: 1px;
                                    width: parent.width;
                                    background: Colors.divider;
                                }
                                HorizontalLayout {
                                    height: parent.height;
                                    spacing: 8px;
                                    OrgButton {
                                        label: (UIState.org-show-done ? "隐藏已完成 (" : "显示已完成 (")
                                            + UIState.org-done-count + ")";
                                        clicked => { UIState.org-show-done-toggled(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: "已完成 " + UIState.org-done-count + " / "
                                            + UIState.org-total-count;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // ── 平铺: one column per list ──────────────────────
                        if UIState.org-tab == 1 && UIState.org-mode == 1 && !UIState.org-bin-open : ScrollView {
                            vertical-stretch: 1;
                            HorizontalLayout {
                                spacing: 12px;
                                for col[i] in UIState.org-board : OrgBoardColumn {
                                    column: col;
                                    card-toggled(id) => { UIState.org-task-done-toggled(id); }
                                    card-opened(id) => { UIState.org-task-selected(id); }
                                    added(title) => { UIState.org-task-add-to(col.id, title); }
                                }
                                Rectangle { width: 1px; }
                            }
                        }

                        // ── 笔记 ───────────────────────────────────────────
                        // A card in the reference app's own order, which is what a
                        // note is *read* by: the age first, at the top-left, with
                        // the pin beside it and the row's ⋯ at the right edge; the
                        // note's own words under that; its tags last (ADR-0115).
                        // The old shape led with the title and buried the age on
                        // the tags line, so a list of notes was scanned by the
                        // field a captured note does not even have.
                        if UIState.org-tab == 0 : ListView {
                            vertical-stretch: 1;
                            // One item = one card *plus its gutter*. The `ListView`
                            // takes no `spacing` and Slint's `margin` is not
                            // dependable here, so the gap is a transparent wrapper
                            // and the card inside it: the item's height is the card
                            // plus 6 px, and the card is anchored to the top of that
                            // box, which is what leaves the 6 px below it and
                            // nothing above (the first card would otherwise sit a
                            // gutter lower than every other).
                            for row[i] in UIState.note-rows : Rectangle {
                                // As tall as what it draws — the board card's own
                                // idiom — because a note with no title is a card with
                                // one line fewer, and the fixed 62 px these rows
                                // used to be left that line as a gap under every
                                // captured note. A card with neither title nor body
                                // is still one line: 无标题. The 2px is the border
                                // itself, which the box has to be tall enough to
                                // draw or the line is clipped.
                                height: 12px + 16px
                                    + (row.title != "" ? 18px : 0px)
                                    + (row.excerpt != "" ? 16px : 0px)
                                    + (row.title == "" && row.excerpt == "" ? 16px : 0px)
                                    + (row.tags != "" ? 16px : 0px)
                                    + 8px + 2px + 6px;
                                background: transparent;

                                Rectangle {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height - 6px;
                                border-radius: Theme.radius-lg;
                                // **A card, not a divider-separated row.** The
                                // Compose shell has drawn every note this way since
                                // its inbox arrived, and the two shells are meant to
                                // look the same; the desktop had a transparent row
                                // with a hover fill, which is a list, not a set of
                                // notes. The recipe is the board card's own
                                // (`OrgBoardCard`): an opaque `surface` and a plain
                                // `border` — theme-neutral, so a card reads as paper
                                // rather than as a coloured row.
                                border-width: 1px;
                                border-color: row.selected || row.picked
                                    ? Colors.accent
                                    : (note-ta.has-hover ? Colors.border-strong : Colors.border);
                                background: row.selected || row.picked
                                    ? Colors.surface-selected
                                    : Colors.surface;
                                animate border-color { duration: Theme.duration-instant; }

                                VerticalLayout {
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    padding-left: 8px;
                                    // While the bin is open the row's own two verbs
                                    // sit at its right edge, so the text stops short
                                    // of them: a title elided *under* a button is a
                                    // title nobody can read.
                                    padding-right: UIState.org-bin-open ? 132px : 8px;
                                    spacing: 2px;
                                    // the age line: what the reference puts first,
                                    // and where the row's ⋯ lives — the corner every
                                    // other per-row menu in this window is in
                                    HorizontalLayout {
                                        height: 16px;
                                        spacing: 6px;
                                        // The pick and the ⋯ are both overlays on this
                                        // line's right end (ADR-0111), so the age
                                        // stops short of the corner whichever of the
                                        // two is up: 22 px clears both a 22 px ⋯ and
                                        // the 18 px box at x = width - 28.
                                        padding-right: 22px;
                                        Text {
                                            // Rust's relative age and never a clock:
                                            // this app stores UTC and has no zone.
                                            text: row.when;
                                            font-family: Typography.ui-font;
                                            font-size: Typography.size-caption;
                                            color: Colors.text-muted;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if row.pinned : Icon {
                                            width: 12px;
                                            height: 12px;
                                            size: 12px;
                                            name: "star";
                                            color: Colors.accent-text;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if row.title != "" : Text {
                                        text: row.title;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-ui;
                                        font-weight: Typography.weight-semibold;
                                        color: Colors.text-primary;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if row.excerpt != "" : Text {
                                        text: row.excerpt;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                        overflow: elide;
                                    }
                                    // A row a ＋ was pressed on and left alone: one
                                    // muted line rather than nothing at all, which
                                    // is what the reference draws as （空笔记）.
                                    if row.title == "" && row.excerpt == "" : Text {
                                        text: "无标题";
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if row.tags != "" : Text {
                                        text: row.tags;
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                note-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { UIState.org-note-selected(row.id); }
                                    // The reference opens this menu with a long
                                    // press; the gesture a pointer has for the same
                                    // question is the right button, which is what
                                    // the page tree's own rows already answer to.
                                    // Off in the bin and while 多选 is on, exactly
                                    // as the ⋯ below is: a binned row's verbs are
                                    // drawn in it, and picking is not asking.
                                    //
                                    // The anchor is the row's **right edge** and not
                                    // the pointer's own position, so the menu opens
                                    // in the same place whichever of the two doors
                                    // was used — the shared popup is placed by its
                                    // right edge (`menu-x` minus its width).
                                    pointer-event(event) => {
                                        if (event.kind == PointerEventKind.up
                                            && event.button == PointerEventButton.right
                                            && !UIState.org-bin-open
                                            && !UIState.org-selecting) {
                                            UIState.org-note-menu-requested(
                                                row.id,
                                                self.absolute-position.x + self.width,
                                                self.absolute-position.y);
                                        }
                                    }
                                }
                                // The ⋯: this row's other door to the menu above,
                                // drawn the way a task row draws its own. `opacity`
                                // and not `visible`, for the task row's reason — the
                                // button appears *under* the pointer, so hiding it
                                // the moment the row loses hover would hide it from
                                // the click that was reaching for it.
                                IconButton {
                                    x: parent.width - self.width - 6px;
                                    y: 3px;
                                    icon-name: "dots-horizontal";
                                    icon-color: Colors.text-muted;
                                    size: 22px;
                                    visible: !UIState.org-selecting && !UIState.org-bin-open;
                                    opacity: note-ta.has-hover || row.selected ? 1 : 0;
                                    clicked => {
                                        UIState.org-note-menu-requested(
                                            row.id,
                                            self.absolute-position.x,
                                            self.absolute-position.y);
                                    }
                                }
                                // The box a long press would have shown on the
                                // reference's row (ADR-0111). Last among the row's
                                // children so it sits above `note-ta`, and clicking
                                // it goes through the same route as clicking the
                                // row: while picking, both mean "this one".
                                if UIState.org-selecting : OrgCheck {
                                    x: parent.width - self.width - 10px;
                                    y: 4px;
                                    checked: row.picked;
                                    box-size: 18px;
                                    toggled => { UIState.org-note-selected(row.id); }
                                }
                                // 回收站: a binned row's own two verbs, at its right
                                // edge and last among the row's children so they are
                                // above `note-ta`. Drawn rather than put in a menu
                                // because the bin is a short list of things the user
                                // came to decide about one at a time — and because
                                // every verb outside those two is a write to a note
                                // that is on no list.
                                if UIState.org-bin-open : HorizontalLayout {
                                    // `preferred-width` and not `self.width`: a layout
                                    // *fills* its parent, so `self.width` here is the
                                    // row's own and the pair came out at the row's left
                                    // edge — on top of the note's own text, which the
                                    // 132 px of `padding-right` above is reserving for
                                    // exactly these two buttons.
                                    x: parent.width - self.preferred-width - 10px;
                                    y: (parent.height - self.height) / 2;
                                    spacing: 4px;
                                    OrgButton {
                                        label: "恢复";
                                        font-size: Typography.size-caption;
                                        clicked => { UIState.org-bin-restored(row.id); }
                                    }
                                    OrgButton {
                                        label: "彻底删除";
                                        font-size: Typography.size-caption;
                                        danger: true;
                                        clicked => { UIState.org-bin-purged(row.id); }
                                    }
                                }
                            }
                            }
                        }
                    }

                    // ── the 悬浮 ＋ (ADR-0115) ─────────────────────────────────
                    // The reference shell's Fab: 56 px, round, the accent colour,
                    // 20 px in from the list's bottom-right corner. It is the notes
                    // tab's only door to a new note, and what it opens is the
                    // *capture layer* rather than an empty row: the reference's Fab
                    // opens its editor, and a note born blank is a row the undo
                    // stack has to carry on behalf of a keystroke that never came.
                    //
                    // It floats over the list, as the reference's does — the last
                    // rows scroll under it, which is the price of a corner that
                    // never moves with the content.
                    //
                    // Declared after the `VerticalLayout` so it is *above* the rows
                    // it covers; gone in the bin and while 多选 is on, where a note
                    // is not what the user came for.
                    if UIState.org-tab == 0 && !UIState.org-bin-open && !UIState.org-selecting : Rectangle {
                        x: parent.width - self.width - 20px;
                        y: parent.height - self.height - 20px;
                        width: 56px;
                        height: 56px;

                        // The shadow, drawn the way `ContextMenu` draws its own: this
                        // renderer has no drop-shadow, so it is a plate behind the
                        // disc, offset down and right.
                        Rectangle {
                            x: 1px;
                            y: 2px;
                            width: parent.width;
                            height: parent.height;
                            border-radius: 28px;
                            background: Colors.shadow;
                        }
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: 28px;
                            background: fab-ta.has-hover ? Colors.accent-text : Colors.accent;
                            animate background { duration: Theme.duration-instant; }

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 26px;
                                height: 26px;
                                name: "plus";
                                size: 26px;
                                color: Colors.text-on-accent;
                            }
                        }
                        fab-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { UIState.org-capture-opened(); }
                        }
                    }
                }

                // ── the detail column (任务's list mode, ADR-0118) ──────────
                // 340 px, always there: it used to slide out from 0, which meant
                // the list reflowed on every selection. Hidden on the board,
                // where the columns want the width — activitywatch's board does
                // the same. Its own edge goes with it: a divider with nothing
                // behind it is a line to nowhere.
                //
                // The 笔记 half has no docked column any more: a note opens as a
                // 浮层 over the list it was picked from (see the card's own
                // overlay below), which is what lets the list own the card.
                if UIState.org-tab == 1 && UIState.org-mode == 0 : Rectangle {
                    width: 1px;
                    background: Colors.divider;
                }
                if UIState.org-tab == 1 && UIState.org-mode == 0 : Rectangle {
                    min-width: 340px;
                    max-width: 340px;
                    clip: true;
                    background: Colors.background;

                    // the column is 任务's alone (the gate above says so), so the
                    // pane inside it does not repeat the test
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;

                        if UIState.org-task-detail.id < 0 : Text {
                            text: "选择一条任务，或按 ＋ 新建。";
                            font-family: Typography.ui-font;
                            font-size: Typography.size-ui;
                            color: Colors.text-muted;
                        }

                        if UIState.org-task-detail.id >= 0 : VerticalLayout {
                            spacing: 10px;

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                OrgCheck {
                                    checked: UIState.org-task-detail.done;
                                    box-size: 18px;
                                    round: true;
                                    toggled => { UIState.org-task-done-toggled(UIState.org-task-detail.id); }
                                }
                                OrgInput {
                                    placeholder: "任务";
                                    font-size: Typography.size-ui-lg;
                                    value <=> UIState.org-task-title-draft;
                                    edited => { UIState.org-field-edited(4); }
                                }
                                IconButton {
                                    icon-name: "trash";
                                    icon-color: Colors.text-muted;
                                    hover-color: Colors.danger;
                                    clicked => { UIState.org-task-deleted(UIState.org-task-detail.id); }
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                OrgField { name: "清单"; width: 40px; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Colors.border;
                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        spacing: 2px;
                                        for entry[i] in UIState.task-list-rows : OrgButton {
                                            label: entry.name;
                                            color-slot: entry.smart ? -1 : entry.color;
                                            font-size: Typography.size-caption;
                                            selected: entry.smart
                                                ? UIState.org-task-detail.list <= 0
                                                : UIState.org-task-detail.list == entry.id;
                                            clicked => {
                                                UIState.org-task-list-set(
                                                    UIState.org-task-detail.id,
                                                    entry.smart ? -1 : entry.id);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                OrgField { name: "优先级"; width: 40px; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Colors.border;
                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        spacing: 2px;
                                        for name[i] in root.priority-names : OrgButton {
                                            label: name;
                                            font-size: Typography.size-caption;
                                            selected: UIState.org-task-detail.priority == i;
                                            clicked => {
                                                UIState.org-task-priority-set(
                                                    UIState.org-task-detail.id, i);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                OrgField { name: "截止"; width: 40px; }
                                OrgInput {
                                    placeholder: "YYYY-MM-DD";
                                    grow: false;
                                    field-width: 108px;
                                    value <=> UIState.org-task-due-draft;
                                    edited => { UIState.org-field-edited(8); }
                                }
                                OrgButton {
                                    label: "今天";
                                    selected: UIState.org-task-detail.due == UIState.org-today;
                                    clicked => {
                                        UIState.org-task-due-set(
                                            UIState.org-task-detail.id,
                                            UIState.org-task-detail.due == UIState.org-today
                                                ? "" : UIState.org-today);
                                    }
                                }
                                if UIState.org-task-detail.due != "" : OrgButton {
                                    label: "清除";
                                    clicked => { UIState.org-task-due-set(UIState.org-task-detail.id, ""); }
                                }
                                if UIState.org-task-detail.overdue : Text {
                                    text: "已逾期";
                                    font-family: Typography.ui-font;
                                    font-size: Typography.size-caption;
                                    color: Colors.danger;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                OrgField { name: "重复"; width: 40px; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Colors.border;
                                    HorizontalLayout {
                                        padding-left: 3px;
                                        padding-right: 3px;
                                        spacing: 2px;
                                        for name[i] in root.repeat-names : OrgButton {
                                            label: name;
                                            font-size: Typography.size-caption;
                                            selected: UIState.org-task-detail.repeat == i;
                                            clicked => {
                                                UIState.org-task-repeat-set(
                                                    UIState.org-task-detail.id, i);
                                            }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                height: 32px;
                                spacing: 8px;
                                OrgField { name: "标签"; width: 40px; }
                                OrgInput {
                                    placeholder: "用逗号分隔";
                                    value <=> UIState.org-task-tags-draft;
                                    edited => { UIState.org-field-edited(6); }
                                }
                            }

                            OrgField { name: "备注"; height: 18px; }
                            OrgInput {
                                placeholder: "备注";
                                multiline: true;
                                hint-height: 84px;
                                value <=> UIState.org-task-notes-draft;
                                edited => { UIState.org-field-edited(5); }
                            }

                            // the checklist: its own box, with the ＋ line
                            // *inside* it, so "add a line" reads as part of the
                            // list rather than as a second, unrelated control
                            VerticalLayout {
                                spacing: 0px;
                                OrgField {
                                    name: "子任务";
                                    height: 18px;
                                }
                                Rectangle {
                                    // Both ends pinned, not `height`: a box that
                                    // holds a scroll area takes its minimum from
                                    // that area's own, so a bare height is a
                                    // *preferred* one and the list pushes it back
                                    // open — the same lesson the columns' widths
                                    // taught (see `OrganizerArea`'s comment).
                                    min-height: 132px;
                                    max-height: 132px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Colors.border;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 0px;
                                        subs := ListView {
                                            vertical-stretch: 1;
                                            for sub[i] in UIState.org-task-detail.subtasks : Rectangle {
                                                height: 28px;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    cross-axis-alignment: center;
                                                    padding-left: 6px;
                                                    OrgCheck {
                                                        checked: sub.done;
                                                        box-size: 14px;
                                                        toggled => {
                                                            UIState.org-subtask-done-toggled(
                                                                UIState.org-task-detail.id,
                                                                sub.id, !sub.done);
                                                        }
                                                    }
                                                    // A line is text until it is
                                                    // clicked: several rows cannot
                                                    // share one draft, and the
                                                    // codebase's rule is one live
                                                    // input at a time.
                                                    if UIState.org-field == 7
                                                        && UIState.org-field-sub == sub.id : OrgInput {
                                                        placeholder: "子任务";
                                                        value <=> UIState.org-subtask-draft;
                                                        edited => { UIState.org-field-edited(7); }
                                                    }
                                                    if UIState.org-field != 7
                                                        || UIState.org-field-sub != sub.id : Text {
                                                        text: sub.title != "" ? sub.title : "子任务";
                                                        font-family: Typography.ui-font;
                                                        font-size: Typography.size-ui;
                                                        color: sub.done
                                                            ? Colors.text-muted
                                                            : Colors.text-primary;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    IconButton {
                                                        icon-name: "x";
                                                        size: 22px;
                                                        clicked => {
                                                            UIState.org-subtask-deleted(
                                                                UIState.org-task-detail.id, sub.id);
                                                        }
                                                    }
                                                }
                                                sub-ta := TouchArea {
                                                    // the title's own strip: the box
                                                    // and the ✕ are separate
                                                    // controls beside it, and a hit
                                                    // area over the whole row would
                                                    // swallow both
                                                    x: 22px;
                                                    y: 0;
                                                    width: parent.width - 50px;
                                                    height: parent.height;
                                                    mouse-cursor: MouseCursor.pointer;
                                                    clicked => {
                                                        UIState.org-subtask-edit(
                                                            UIState.org-task-detail.id, sub.id);
                                                    }
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 28px;
                                            HorizontalLayout {
                                                spacing: 6px;
                                                padding-left: 6px;
                                                OrgButton {
                                                    label: "＋ 添加子任务";
                                                    accent: true;
                                                    font-size: Typography.size-caption;
                                                    clicked => {
                                                        UIState.org-subtask-added(
                                                            UIState.org-task-detail.id);
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                OrgField {
                                                    name: UIState.org-task-detail.subtasks-done + "/"
                                                        + UIState.org-task-detail.subtasks-total;
                                                    width: 40px;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            OrgButton {
                                height: 30px;
                                label: "删除任务";
                                danger: true;
                                clicked => {
                                    UIState.org-task-deleted(UIState.org-task-detail.id);
                                }
                            }
                        }
                    }
                }

                // ── the nav column (任务 only, ADR-0118) ────────────────────
                // The notes half has no column here any more: its two tabs were a
                // second copy of the left sidebar's pinned rows, and its filter is
                // the list header's own chip row now. 任务 keeps it, because
                // 收集箱 / 今天 / 最近 7 天 / the lists *are* that half's navigation
                // and there is nowhere else for them to be.
                if UIState.org-tab == 1 : Rectangle {
                    // min *and* max, not `width`: in a layout an explicit width
                    // is only the *preferred* one, and Slint raises it to
                    // whatever the content says it needs. The detail column's
                    // own content asked for 545 px, which is how a 340 px panel
                    // took the width out of the list beside it.
                    min-width: 208px;
                    max-width: 208px;
                    background: Colors.sidebar;
                    // The card's right edge, because this column is the card's
                    // last one: the tag sidebar sits on the *right* (ADR-0112),
                    // which is the side the reference puts it on and the side a
                    // right-handed pointer reaches without crossing the rows.
                    border-top-right-radius: Theme.radius-lg;
                    border-bottom-right-radius: Theme.radius-lg;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 1px;

                        // the two tabs, and the one "+" that creates in whichever
                        // tab is showing (a note in 笔记, a task in 任务)
                        HorizontalLayout {
                            height: 30px;
                            spacing: 2px;
                            OrgButton {
                                label: "笔记";
                                selected: UIState.org-tab == 0;
                                clicked => { UIState.org-open-requested(0); }
                            }
                            OrgButton {
                                label: "任务";
                                selected: UIState.org-tab == 1;
                                clicked => { UIState.org-open-requested(1); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // The ＋ that makes the thing this tab is about — and
                            // only on 任务 (ADR-0115): the notes half's ＋ is the
                            // floating one at the list's bottom-right, and two
                            // buttons for one verb in one column pair is one button
                            // too many. 任务 keeps its own because a task has no
                            // capture layer — its quick-add line is already in the
                            // list, in the list the task lands in.
                            if UIState.org-tab == 1 : IconButton {
                                icon-name: "plus";
                                size: 26px;
                                clicked => { UIState.org-task-create(); }
                            }
                        }

                        Rectangle { height: 6px; }

                        // 任务's own needle. The notes half's is in its filter bar
                        // (ADR-0118), and the two halves are never on screen
                        // together, so neither box is a second thing to clear.
                        OrgInput {
                            hint-height: 30px;
                            placeholder: "搜索任务";
                            value <=> UIState.org-query;
                            edited => { UIState.org-query-changed(); }
                        }

                        Rectangle { height: 6px; }

                        // ── 任务: the smart views, then the lists ───────────
                        // (The 笔记 half's 全部笔记 row and its tag column moved to
                        // the list's own filter bar — ADR-0118.)
                        if UIState.org-tab == 1 : VerticalLayout {
                            spacing: 1px;
                            for name[i] in root.smart-names : OrgNavRow {
                                label: name;
                                count: UIState.org-smart-counts[i];
                                // The bin is a place of its own: while it is open no
                                // view and no list is the one being looked at, and a
                                // second lit row would say otherwise.
                                selected: UIState.org-list < 0 && UIState.org-view == i
                                    && !UIState.org-bin-open;
                                clicked => { UIState.org-view-picked(i); }
                            }
                            Rectangle { height: 8px; }
                            Text {
                                text: "清单";
                                height: 22px;
                                font-family: Typography.ui-font;
                                font-size: Typography.size-caption;
                                color: Colors.text-muted;
                                vertical-alignment: center;
                                x: 13px;
                            }
                            for entry[i] in UIState.task-list-rows : OrgNavRow {
                                label: entry.name;
                                count: entry.count;
                                color-slot: entry.smart ? -1 : entry.color;
                                // The inbox is a *projection*, not a row: there is
                                // nothing there to rename, recolour or delete.
                                menuable: !entry.smart;
                                renaming: !entry.smart && UIState.org-list-renaming == entry.id;
                                selected: entry.smart
                                    ? UIState.org-list < 0 && UIState.org-view == 0
                                        && !UIState.org-bin-open
                                    : UIState.org-list == entry.id && !UIState.org-bin-open;
                                clicked => { UIState.org-list-picked(entry.id); }
                                menu-requested(x, y) => {
                                    UIState.org-list-menu-requested(entry.id, x, y);
                                }
                                rename-committed(text) => {
                                    UIState.org-list-name-set(entry.id, text);
                                    UIState.org-list-renaming = -1;
                                }
                                rename-cancelled => { UIState.org-list-renaming = -1; }
                            }
                            OrgNavRow {
                                label: "＋ 新建清单";
                                accent: true;
                                clicked => { UIState.org-list-created(); }
                            }
                            // The 任务 tab's tag filter, below the lists: a task
                            // carries tags exactly as a note does, and 反向筛选 is
                            // the same two halves here as there.
                            Rectangle { height: 10px; }
                            OrgTagColumn { }
                        }

                        Rectangle { vertical-stretch: 1; min-height: 8px; }

                        // 回收站 (core ADR-0003): one row on **both** tabs, because
                        // what it holds is the half the user is standing on. Drawn
                        // last-but-one so it sits where a nav puts the place you go
                        // to when the list is not what you want.
                        OrgNavRow {
                            label: "回收站";
                            count: UIState.org-tab == 0
                                ? UIState.org-bin-note-count
                                : UIState.org-bin-task-count;
                            selected: UIState.org-bin-open;
                            clicked => { UIState.org-bin-toggled(); }
                        }

                        // the finished ones are a view like any other, so they
                        // sit where a nav puts the thing you go to last
                        if UIState.org-tab == 1 : OrgNavRow {
                            label: "已完成";
                            count: UIState.org-smart-counts[4];
                            selected: UIState.org-list < 0 && UIState.org-view == 4
                                && !UIState.org-bin-open;
                            clicked => { UIState.org-view-picked(4); }
                        }
                    }
                }

                // the columns' own edge, drawn rather than bordered: a border
                // would put a line on all four sides. It goes with the nav
                // column it belongs to.
                if UIState.org-tab == 1 : Rectangle { width: 1px; background: Colors.divider; }
            }

            // ── the 笔记 half's note page, as a 浮层 (ADR-0118) ──────────────
            // The note the list picked, drawn *over* the rows rather than beside
            // them: the notes half's card is the rows' now. A docked column cost
            // them a third of the card whether a note was open or not, and the
            // row that opened the note is *context* — which note among which
            // others — which is what the list behind this card still says.
            //
            // Last among the card's children, so it sits above the list; the
            // `TouchArea` inside it is what keeps a click on its own padding off
            // the rows. ✕ and Escape close it, and picking another row moves it.
            if UIState.org-tab == 0 && UIState.org-note-detail.id >= 0 : Rectangle {
                x: parent.width - self.width - 16px;
                y: 16px;
                width: min(420px, parent.width - 32px);
                height: parent.height - 32px;

                // the shadow plate, the way `ContextMenu` and the 悬浮 ＋ draw
                // theirs: this renderer has no drop-shadow
                Rectangle {
                    x: 2px;
                    y: 3px;
                    width: parent.width;
                    height: parent.height;
                    border-radius: Theme.radius-lg;
                    background: Colors.shadow;
                }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: Theme.radius-lg;
                    border-width: 1px;
                    border-color: Colors.border-strong;
                    background: Colors.surface-overlay;
                    clip: true;

                    // Swallows the card's own clicks — its padding, its title, the
                    // space under the last field — so that the rows beside it stay
                    // clickable and its own margin is not a hole onto them.
                    // Declared first, so every control below sits above it.
                    TouchArea { mouse-cursor: MouseCursor.pointer; }

                    // The fields are a column taller than the card can be, so the
                    // page scrolls rather than clipping 详细信息 off the bottom.
                    ScrollView {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                OrgInput {
                                    placeholder: "标题";
                                    font-size: Typography.size-ui-lg;
                                    value <=> UIState.org-note-title-draft;
                                    edited => { UIState.org-field-edited(1); }
                                }
                                IconButton {
                                    icon-name: "star";
                                    icon-color: UIState.org-note-detail.pinned
                                        ? Colors.accent-text
                                        : Colors.text-muted;
                                    clicked => { UIState.org-note-pin-toggled(UIState.org-note-detail.id); }
                                }
                                // 转为待办: the note becomes a task and the note goes —
                                // no dialog, because the notice band is the way back.
                                IconButton {
                                    icon-name: "todo-check";
                                    icon-color: Colors.text-muted;
                                    hover-color: Colors.accent-text;
                                    clicked => { UIState.org-note-to-task(UIState.org-note-detail.id); }
                                }
                                IconButton {
                                    icon-name: "trash";
                                    icon-color: Colors.text-muted;
                                    hover-color: Colors.danger;
                                    clicked => { UIState.org-note-deleted(UIState.org-note-detail.id); }
                                }
                                // The panel's own door, in the corner every popup in
                                // this window closes from. Escape is the same ask.
                                IconButton {
                                    icon-name: "x";
                                    icon-color: Colors.text-muted;
                                    clicked => { UIState.org-note-closed(); }
                                }
                            }

                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                OrgField { name: "标签"; width: 40px; }
                                OrgInput {
                                    placeholder: "用逗号分隔";
                                    value <=> UIState.org-note-tags-draft;
                                    edited => { UIState.org-field-edited(3); }
                                }
                            }

                            OrgInput {
                                placeholder: "正文";
                                multiline: true;
                                hint-height: 300px;
                                value <=> UIState.org-note-body-draft;
                                edited => { UIState.org-field-edited(2); }
                            }

                            // 引用 (SPEC §四十一): the notes that answer this one, and
                            // the field that writes them — a reply is a note whose
                            // `ref_note` names this one (core ADR-0001). Committed on
                            // Enter or the 评论 button and not on a settle, because a
                            // reply is a *create* and half a row is not a row.
                            VerticalLayout {
                                spacing: 4px;
                                OrgField {
                                    name: "评论 " + UIState.org-note-replies.length;
                                    height: 18px;
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    spacing: 8px;
                                    OrgInput {
                                        placeholder: "写一条评论…";
                                        value <=> UIState.org-reply-draft;
                                        accepted => { UIState.org-reply-submitted(); }
                                    }
                                    OrgButton {
                                        label: "评论";
                                        accent: true;
                                        font-size: Typography.size-caption;
                                        clicked => { UIState.org-reply-submitted(); }
                                    }
                                }
                                for reply[i] in UIState.org-note-replies : Rectangle {
                                    // The card hugs its text, the board card's own
                                    // idiom (`height` off the wrapped text's
                                    // preferred-height): a reply is a line or two, and
                                    // the card's leftover height must not be poured
                                    // into the newest one.
                                    height: reply-text.preferred-height + 14px + 18px;
                                    background: Colors.hover-fill;
                                    border-radius: Theme.radius-sm;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        reply-text := Text {
                                            text: reply.body != "" ? reply.body : reply.title;
                                            font-family: Typography.ui-font;
                                            font-size: Typography.size-ui;
                                            color: Colors.text-primary;
                                            wrap: word-wrap;
                                        }
                                        OrgMeta { tags: reply.tags; when: reply.when; height: 14px; }
                                    }
                                }
                            }

                            // 详细信息: what the store holds about this note, and
                            // the one thing it does not hold.
                            //
                            // A disclosure **below** the body rather than the
                            // reference's bottom sheet, for two reasons. Slint has
                            // no sheet, and a popup window for six read-only rows
                            // is a window inside a window; and opening it must not
                            // move the field the user is typing into — above the
                            // body it would shove 正文 down every time.
                            //
                            // The header is a Rectangle with a TouchArea under its
                            // text: a layout child that is only a row of text has
                            // nothing to click on for the empty part of the card.
                            Rectangle {
                                height: 24px;
                                details-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        UIState.org-note-details-open = !UIState.org-note-details-open;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    Icon {
                                        width: 14px;
                                        height: 14px;
                                        name: UIState.org-note-details-open
                                            ? "chevron-down"
                                            : "chevron-right";
                                        size: 14px;
                                        color: Colors.text-muted;
                                    }
                                    Text {
                                        text: "详细信息";
                                        font-family: Typography.ui-font;
                                        font-size: Typography.size-caption;
                                        color: Colors.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if UIState.org-note-details-open : VerticalLayout {
                                spacing: 2px;
                                OrgDetailRow { label: "编号"; value: UIState.org-note-details.id; }
                                // SPEC §四十一's 唯一 ID: what 复制 hands an AI and
                                // what a batch instruction names this note by. Next to
                                // 编号 because they are both "which note", and only one
                                // of them survives a sync.
                                OrgDetailRow { label: "唯一 ID"; value: UIState.org-note-details.uuid; }
                                OrgDetailRow { label: "创建"; value: UIState.org-note-details.created; }
                                OrgDetailRow { label: "修改"; value: UIState.org-note-details.edited; }
                                OrgDetailRow { label: "标签"; value: UIState.org-note-details.tags; }
                                OrgDetailRow { label: "长度"; value: UIState.org-note-details.length; }
                                OrgDetailRow { label: "置顶"; value: UIState.org-note-details.pinned; }
                                // The reference says this out loud instead of
                                // painting an empty 历史 list: `quire-core` keeps
                                // one copy of a note, so there is no version to
                                // restore to — 撤销 walks an edit back, and that
                                // is all there is.
                                Text {
                                    text: "没有历史版本：资料库只保存当前这一份，撤销可以回退编辑，但没有按时间恢复的版本。";
                                    wrap: word-wrap;
                                    font-family: Typography.ui-font;
                                    font-size: Typography.size-caption;
                                    color: Colors.text-muted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── 指令 (SPEC §四十一): the batch dialog ────────────────────────────────
    //
    // A card over the area rather than a window-level popup, because what it acts
    // on is *these* rows and the window has no text-entry overlay to reuse: the
    // delete confirmation is one line of message, and this is a page of JSON. Being
    // the last child of the area is what puts it above the three columns without a
    // second scrim in `AppWindow` — and the `TouchArea` is what makes the rows
    // behind it unclickable while a batch is being pasted.
    if UIState.org-cmd-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Colors.scrim;
        TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            // Bounded on both axes: a card that grew with its text would push its
            // own buttons off a short window, and the paste box is the one thing
            // that should scroll.
            width: min(parent.width - 60px, 680px);
            height: min(parent.height - 60px, 470px);
            background: Colors.surface-overlay;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Colors.border-strong;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    height: 24px;
                    text: UIState.org-cmd-tab == 1 ? "批量操作指令（任务）" : "批量操作指令（笔记）";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui-lg;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-primary;
                    vertical-alignment: center;
                }
                // The actions, spelled out: the same list the template carries, so
                // the box does not have to be read off the example. `delete` and
                // `restore` are 回收站's two verbs (core ADR-0003), which is why the
                // first one no longer throws the row away.
                Text {
                    height: 30px;
                    text: UIState.org-cmd-tab == 1
                        ? "粘贴 AI 返回的 JSON（{\"operations\":[…] }）。可用 action：create / update / delete / restore / add_tags / remove_tags / set_tags / set_completed / move / set_priority / set_due / add_subtask / set_subtask / remove_subtask / comment。delete 移入回收站，restore 取出。目标用 uuid（推荐，跨设备唯一）或 id。"
                        : "粘贴 AI 返回的 JSON（{\"operations\":[…] }）。可用 action：create / update / delete / restore / add_tags / remove_tags / set_tags / comment。delete 移入回收站，restore 取出。目标用 uuid（推荐，跨设备唯一）或 id。";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: cmd-input.has-focus ? Colors.border-strong : Colors.border;
                    background: Colors.background;
                    cmd-input := TextInput {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        height: parent.height - 12px;
                        text <=> UIState.org-cmd-text;
                        wrap: word-wrap;
                        font-family: Typography.mono-font;
                        font-size: Typography.size-caption;
                        color: Colors.text-primary;
                        selection-foreground-color: Colors.text-on-accent;
                        selection-background-color: Colors.selection;
                    }
                    if UIState.org-cmd-text == "" : Text {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        text: "在此粘贴 JSON…";
                        font-family: Typography.ui-font;
                        font-size: Typography.size-caption;
                        color: Colors.text-muted;
                    }
                }
                HorizontalLayout {
                    height: 30px;
                    spacing: 8px;
                    OrgButton {
                        label: "复制示例";
                        font-size: Typography.size-caption;
                        clicked => { UIState.org-command-example(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    OrgButton {
                        label: "取消";
                        font-size: Typography.size-caption;
                        clicked => { UIState.org-command-closed(); }
                    }
                    OrgButton {
                        label: "执行";
                        font-size: Typography.size-caption;
                        selected: true;
                        accent: true;
                        clicked => { UIState.org-command-run(); }
                    }
                }
            }
        }
    }

    // ── the capture layer (ADR-0115) ──────────────────────────────────────────
    // What the 悬浮 ＋ opens: a field, a count of what its `#`-tokens will file
    // under, and the ➤ that is the only thing in the area that commits it.
    //
    // **Nothing is written until ➤.** The draft is a property and the layer is a
    // mode, so closing it — by ✕, by Escape, by a click on the scrim — throws away
    // a half-written note and leaves the file, the catalog and the undo stack
    // exactly where they were. That is the reference's own rule and the Android
    // copy's (ADR-0015 there), and it is why this is not a new blank row: a row
    // that exists because a ＋ was pressed is a row every count and every rebuild
    // has to carry until someone decides to delete it.
    //
    // An overlay inside the area rather than a window popup, for the reason 指令's
    // card is one: what it acts on is *these* rows. Its `TouchArea` is what makes
    // the three columns behind it unclickable while a note is being written.
    if UIState.org-capture-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Colors.scrim;

        // The scrim is the dismissal. A sibling *under* the card rather than a
        // wrapper, so a click in the field never reaches it — a tap anywhere
        // outside the card closes the layer, which is what the reference shell
        // does with a swipe down and with its back gesture.
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { UIState.org-capture-closed(); }
        }

        Rectangle {
            // Bottom-centre, the shape the reference shell's sheet has: the field
            // grows upward from a floor that does not move, so the card is the same
            // size whether one word or nine lines are being typed into it.
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 24px;
            width: min(parent.width - 80px, 620px);
            height: 236px;
            background: Colors.surface-overlay;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Colors.border-strong;

            // Swallows the card's own clicks — its padding, its title, the hint
            // line under the field — so that only the scrim *around* the card
            // closes the layer. Declared first, so every control below sits above
            // it; without it a click on the card's own margin would land on the
            // scrim behind and dismiss the note being written.
            TouchArea { }

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    Text {
                        text: "新建笔记";
                        font-family: Typography.ui-font;
                        font-size: Typography.size-ui-lg;
                        font-weight: Typography.weight-semibold;
                        color: Colors.text-primary;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        icon-name: "x";
                        size: 22px;
                        clicked => { UIState.org-capture-closed(); }
                    }
                }

                // ── 标签建议 (ADR-0118) ─────────────────────────────────────
                // The tray the Android composer raises for the `#token` being
                // typed; tapping a chip rewrites that token into the whole tag
                // (its `tagSuggestions` / `applyTagSuggestion`). Rust decides
                // what is in it — the field only reports its edits — so the pool,
                // the prefix rule and the "a space ends a token" rule are one
                // definition and not a second copy of the parser.
                //
                // Above the field rather than under it: the card grows upward
                // from a floor that does not move, and a tray between the field
                // and the ➤ would shove the button the eye is already on.
                if UIState.org-tag-suggestions.length > 0 : ScrollView {
                    height: 30px;
                    HorizontalLayout {
                        spacing: 6px;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        for tag[i] in UIState.org-tag-suggestions : OrgFilterChip {
                            label: "#" + tag;
                            // Rust rewrites the token and hands the caret's new
                            // byte offset back; the field takes it, so the next
                            // keystroke lands after the tag and not inside it.
                            clicked => {
                                UIState.org-tag-suggest-picked(tag);
                                capture-input.set-selection-offsets(
                                    UIState.org-capture-caret,
                                    UIState.org-capture-caret,
                                );
                            }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: capture-input.has-focus ? Colors.border-strong : Colors.border;
                    background: Colors.background;

                    // The placeholder, under the field: Slint's `TextInput` has none,
                    // and an empty box with no hint is a box nobody knows what to type
                    // into. It names the one convention this layer has — `#` marks a
                    // tag — which is the only thing a user has to be told.
                    if UIState.org-capture-draft == "" : Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        text: "记录点什么… 使用 #标签 标记";
                        font-family: Typography.ui-font;
                        font-size: Typography.size-ui;
                        color: Colors.text-muted;
                    }
                    capture-input := TextInput {
                        x: 10px;
                        y: 8px;
                        width: parent.width - 20px;
                        height: parent.height - 16px;
                        text <=> UIState.org-capture-draft;
                        wrap: word-wrap;
                        font-family: Typography.ui-font;
                        font-size: Typography.size-ui;
                        color: Colors.text-primary;
                        selection-foreground-color: Colors.text-on-accent;
                        selection-background-color: Colors.selection;
                        // Every keystroke re-asks Rust for the 标签建议 tray: the
                        // field owns the text, and the pool is the catalog's.
                        edited => { UIState.org-capture-draft-changed(); }
                        // Escape closes the layer and Ctrl+Enter *is* the ➤ — the
                        // reference app's own pair of keys, and what lets a
                        // multi-line note be sent without the pointer leaving the
                        // field it was written in.
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                UIState.org-capture-closed();
                                accept
                            } else if (event.modifiers.control && event.text == Key.Return) {
                                UIState.org-capture-sent();
                                accept
                            } else {
                                reject
                            }
                        }
                        // The caret is asked for on the frame the field exists, so
                        // the layer is ready to be typed into the moment it appears
                        // — and it goes *after* whatever `org-capture-open` seeded
                        // (the tag filter's `#token`), not in front of it.
                        init => {
                            capture-input.focus();
                            capture-input.set-selection-offsets(
                                UIState.org-capture-caret,
                                UIState.org-capture-caret,
                            );
                        }
                    }
                }

                HorizontalLayout {
                    height: 40px;
                    spacing: 8px;
                    Text {
                        // The keyboard hint is the desktop's, like the quick-add
                        // line's 回车创建: a touch copy of this layer drops it
                        // (ADR-0115's SPEC section).
                        text: "#标签 会被提取 · Ctrl+Enter 发送 · Esc 关闭";
                        font-family: Typography.ui-font;
                        font-size: Typography.size-caption;
                        color: Colors.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // The ➤: the reference app's send, drawn rather than typed, and
                    // this layer's only verb. Dimmed over an empty draft instead of
                    // hidden — the button is where the eye already is, and a control
                    // that vanishes is a control the user has to find twice — and
                    // Rust refuses the write as well, so a click on a dimmed ➤
                    // commits nothing.
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: send-ta.has-hover && UIState.org-capture-draft != ""
                            ? Colors.accent-text : Colors.accent;
                        opacity: UIState.org-capture-draft == "" ? 0.4 : 1;
                        animate opacity { duration: Theme.duration-instant; }

                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            name: "send";
                            size: 18px;
                            color: Colors.text-on-accent;
                        }
                        send-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { UIState.org-capture-sent(); }
                        }
                    }
                }
            }
        }
    }
}
