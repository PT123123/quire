// Document surface. A ListView gives us the virtualization skeleton from day
// one: delegates exist only for visible rows. ListView delegates must be a
// single `for`, so page-level chrome (hero spacer, page title, tail spacer)
// rides inside the first/last DocumentRow wrappers instead.

import { ListView } from "std-widgets.slint";
import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography, PageType } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { EditorBlock } from "./EditorBlock.slint";
import { BacklinkPanel } from "./BacklinkPanel.slint";
import { IconButton } from "./IconButton.slint";
import { Button } from "./Button.slint";
import { BlockRow, UIState } from "../Types.slint";

component DocumentRow inherits Rectangle {
    in property <BlockRow> block;
    in property <int> depth;
    in property <int> index;
    in property <bool> first;

    // The tail row also carries the backlink panel, and the panel's own height
    // is 0 on a page nothing refers to — so a page with no backlinks measures
    // exactly as it did before the panel existed.
    height: head.height + body.height + panel.height
        + (block.tail ? Theme.spacing-hero * 2 : 0px);

    // The page's own emoji, above its title (SPEC §三十八). It takes no space
    // at all until one is set, so the 56k rows below it measure exactly as
    // they did before this slice. Display only: the picker opens from the
    // page's ⋯ menu, whose anchor the controller already knows.
    property <length> icon-height: UIState.page-icon == ""
        ? 0px
        : icon.preferred-height + Theme.spacing-md;

    head := Rectangle {
        // Both x and y are spelled out on purpose. A Rectangle that binds
        // `height` but leaves `y` alone is centred in its parent, and this
        // delegate grows taller with its block -- so a tall first block (the
        // table) dragged the page title down on top of itself.
        x: 0px;
        y: 0px;
        width: parent.width;
        height: root.first
            ? Theme.spacing-hero + root.icon-height + title.height + Theme.spacing-lg
            : 0px;

        icon := Text {
            x: root.content-x;
            y: Theme.spacing-hero;
            width: root.content-width;
            visible: root.first && UIState.page-icon != "";
            text: UIState.page-icon;
            font-family: Typography.emoji-font;
            font-size: PageType.size-page-icon;
            color: Colors.text-primary;
        }

        // click the big title to rename in place (Notion-style)
        title-ta := TouchArea {
            x: root.content-x;
            y: Theme.spacing-hero + root.icon-height;
            width: root.content-width;
            height: root.first ? title.height : 0px;
            enabled: root.first && !UIState.title-editing;
            visible: root.first;
            mouse-cursor: MouseCursor.text;
            clicked => {
                UIState.title-editing = true;
            }
        }
        title := Text {
            x: root.content-x;
            y: Theme.spacing-hero + root.icon-height;
            width: root.content-width;
            visible: root.first && !UIState.title-editing;
            text: UIState.page-title;
            font-family: PageType.font-family;
            font-weight: Typography.weight-bold;
            font-size: PageType.size-page-title;
            // without an explicit factor the text height is the font size
            // only, and descenders (g, y) collide with the first block
            line-height-factor: 1.28;
            color: Colors.text-primary;
        }
        title-input := TextInput {
            x: root.content-x;
            y: Theme.spacing-hero + root.icon-height;
            width: root.content-width;
            visible: root.first && UIState.title-editing;
            enabled: root.first && UIState.title-editing;
            // the preferred height is the font size alone: descenders (g, y)
            // collide with the line box (A4 sweep, title-edit scene)
            height: max(self.preferred-height, PageType.size-page-title * 1.4);
            text <=> UIState.page-title;
            font-family: PageType.font-family;
            font-weight: Typography.weight-bold;
            font-size: PageType.size-page-title;
            line-height-factor: 1.28;
            color: Colors.text-primary;
            single-line: true;
            selection-foreground-color: Colors.text-primary;
            selection-background-color: Colors.selection;
            accepted => {
                UIState.title-commit(self.text);
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    UIState.title-cancel();
                    accept
                } else {
                    reject
                }
            }
            init => {
                title-input.focus();
                title-input.select-all();
            }
        }
    }

    body := EditorBlock {
        x: 0px;
        y: head.height;
        block: root.block;
        depth: root.block.depth;
        index: root.index;
        row-y: parent.y + head.height;
        content-x: root.content-x;
        content-width: root.content-width;
    }

    // The page's foot (SPEC §四十): what points back at this page. It rides on
    // the tail row for the same reason the title rides on the first one — a
    // `ListView` takes a single `for`, so page-level chrome lives inside the
    // row wrappers. The panel is the last thing above the bottom spacer.
    panel := BacklinkPanel {
        x: 0px;
        y: head.height + body.height;
        width: parent.width;
        content-x: root.content-x;
        content-width: root.content-width;
        active: root.block.tail;
    }

    in property <length> content-x;
    in property <length> content-width;
}

export component Editor inherits Rectangle {
    // content column centered, min gutter so handles never touch the window
    // edge. A full-width page keeps the gutter and drops the centering: the
    // column is then whatever the window offers, which is the whole point of
    // the switch (SPEC §三十八).
    property <length> gutter: PageType.full-width
        ? Theme.spacing-xl
        : Math.max(
            Theme.spacing-xl,
            (root.width - Theme.editor-max-width) / 2);

    background: Colors.background;

    // The editor's own height is the viewport the database window is computed
    // from (SPEC §三十九): every database on the page sees the same viewport,
    // so the number is reported once per resize here and never measured
    // inside a row — Rust cannot see Slint's layout, and this is the one
    // number its window arithmetic needs.
    changed height => {
        UIState.editor-viewport-h = self.height;
    }

    // in-page find bar (Ctrl+F)
    if UIState.find-open : Rectangle {
        x: parent.width - self.width - Theme.spacing-md;
        y: Theme.spacing-md;
        width: 340px;
        height: 36px;
        border-radius: Theme.radius-md;
        background: Colors.surface-overlay;
        border-width: 1px;
        border-color: Colors.border;

        HorizontalLayout {
            x: 6px;
            y: 4px;
            width: parent.width - 12px;
            spacing: Theme.spacing-sm;

            Rectangle {
                width: 130px;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: Colors.background;
                clip: true;
                find-input := TextInput {
                    x: 6px;
                    width: parent.width - 12px;
                    y: (parent.height - self.preferred-height) / 2;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-primary;
                    single-line: true;
                    text <=> UIState.find-term;
                    // find-as-you-type: every keystroke rebuilds the session
                    edited => {
                        UIState.find-start();
                    }
                    accepted => {
                        UIState.find-start();
                        UIState.find-step(1);
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            UIState.find-close();
                            accept
                        } else {
                            reject
                        }
                    }
                    init => {
                        find-input.focus();
                    }
                }
                if UIState.find-term == "" : Text {
                    x: 6px;
                    text: "Find";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-muted;
                    vertical-alignment: center;
                }
            }
            Text {
                text: UIState.find-label;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
                vertical-alignment: center;
                width: 64px;
                overflow: elide;
            }
            IconButton {
                vertical-stretch: 0;
                cross-axis-self-alignment: center;
                icon-name: "chevron-up";
                size: 24px;
                clicked => {
                    UIState.find-step(-1);
                }
            }
            IconButton {
                vertical-stretch: 0;
                cross-axis-self-alignment: center;
                icon-name: "chevron-down";
                size: 24px;
                clicked => {
                    UIState.find-step(1);
                }
            }
            IconButton {
                vertical-stretch: 0;
                cross-axis-self-alignment: center;
                icon-name: "x";
                size: 24px;
                clicked => {
                    UIState.find-close();
                    UIState.find-open = false;
                }
            }
        }
    }

    // footer: page stats, bottom-right, out of the content's way
    Text {
        x: parent.width - self.width - Theme.spacing-md;
        y: parent.height - self.height - 6px;
        text: UIState.page-stats;
        font-family: Typography.ui-font;
        font-size: Typography.size-caption;
        color: Colors.text-muted;
    }

    // The highlight counts characters, so it needs the width of one of them —
    // and the only honest source for that number is the font, asked once here
    // for the whole app. Not inside a row: which rows the list view realizes
    // depends on the scroll position, and where a block's lines break must not.
    // Ten digits because a fractional advance rounds better over a run.
    code-probe := Text {
        x: -1000px;
        y: -1000px;
        text: "0000000000";
        font-family: Typography.mono-font;
        font-size: PageType.size-code;
        wrap: no-wrap;
        visible: false;
        changed width => {
            UIState.code-advance = self.width / 10;
        }
    }

    // The scroll position mirror lets the bench harness drive the same
    // viewport a mouse wheel would (scene F); normal wheel use still works
    // because Flickable writes its internal changes back through the
    // two-way binding.
    list := ListView {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        content-width: parent.width;
        content-y <=> UIState.editor-scroll-y;

        for row[idx] in UIState.blocks : DocumentRow {
            block: row;
            depth: row.depth;
            index: idx;
            first: idx == 0;
            content-x: root.gutter;
            content-width: list.content-width - 2 * root.gutter;
        }
    }

    // empty state — a page with no blocks yet. The panel is a click target:
    // this is the one place on the page with nothing to select, so it has to
    // make its own first block (see UIState.empty-page-started).
    if UIState.blocks.length == 0 : Rectangle {
        width: parent.width;
        height: parent.height;
        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                UIState.empty-page-started();
            }
        }
        VerticalLayout {
            spacing: Theme.spacing-sm;
            alignment: center;
            Icon {
                width: 40px;
                height: 40px;
                size: 40px;
                name: "page";
                color: Colors.text-muted;
                cross-axis-self-alignment: center;
            }
            Text {
                text: "This page is empty";
                font-family: Typography.ui-font;
                font-size: Typography.size-h3;
                font-weight: Typography.weight-semibold;
                color: Colors.text-secondary;
                horizontal-alignment: center;
            }
            Text {
                text: "Click here to write, or press Enter in the title above.";
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                color: Colors.text-muted;
                horizontal-alignment: center;
            }
            if UIState.workspace-empty : Button {
                text: "Create your first page";
                primary: true;
                clicked => {
                    UIState.page-create-requested();
                }
            }
        }
    }
}
